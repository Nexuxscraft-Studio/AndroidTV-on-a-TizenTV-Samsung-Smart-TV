# Build 064 - P1/P2 peripheral compile-coverage fragment (Nike-L).
# All driver bindings are upstream subsystems; the SoC glue is still to be
# ported from the Samsung 4.1.10 GPL sources. Compile coverage only.
# Audio (ASoC)
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
# Video decode (MFC -> V4L2 mem2mem) + CEC
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_V4L_MEM2MEM_DRIVERS=y
CONFIG_VIDEO_DEV=y
CONFIG_MEDIA_CEC_SUPPORT=y
# Input + IR remote
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_RC_CORE=y
CONFIG_LIRC=y
# Networking (sdp-mac)
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
