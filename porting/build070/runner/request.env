# Build 070 – Auftrag für den self-hosted Runner ("debian").
# Ein Push dieser Datei (Branch claude/build070-*) startet
# .github/workflows/build070-drivers.yml. Wird geparst und validiert, nicht
# gesourct. Gleiche Concurrency-Gruppe wie Build 068/069
# (build068-selfhosted-v2): NIE zusammen mit einer anderen request.env pushen.
#
# MODE        sources | show | kernel
#   sources   Firmware-dtb.bin per Range-Request holen (SHA-256 gegen Build 004),
#             Samsung-GPL-Paket laden + entpacken, Inventar + DT-Knotentabelle
#             ins Log (I>/T>/N>-Zeilen). Liest nur, baut nichts.
#   show      Dateien aus GPL_DIR/src bzw. GPL_DIR/firmware ins Log drucken
#             (S>-Zeilen), für die Portierung 4.1.10 -> 6.6.
#   kernel    gemeinsamen Q60T-Kernel bauen (Build-059-Profil android,
#             Patches 0001–0012, W=1 -Werror-Gate, dtc W=1).
# LOS_DIR     LineageOS-Baum (nur für den LLVM-Prebuilt)
# GPL_DIR     Ablage für GPL-Quellen und Firmware-DTBs auf dem Runner
# SHOW_PATHS  (show) bis 12 Pfade relativ zu GPL_DIR, Leerzeichen-getrennt
# SHOW_LINES  (show) Zeilenbereich je Datei, z. B. 1-400
# REQUEST_ID  frei; ändert sich -> neuer Lauf

MODE=show
LOS_DIR=/mnt/github-runner/lineage-22.2
GPL_DIR=/mnt/github-runner/gpl
SHOW_PATHS=src/media/tztv-media-nike/sdp_logo_nike/Makefile src/media/tztv-media-nike/sdp_logo_nike/nikem/Makefile src/media/tztv-media-nike/sdp_logo_nike/sdp_logo_drv.c src/media/tztv-media-nike/sdp_logo_nike/sdp_logo_drv.h src/media/tztv-media-nike/sdp_logo_nike/nikem/sdp_logo.c src/media/tztv-media-nike/sdp_logo_nike/nikem/sdp_logo.h src/media/tztv-media-nike/sdp_logo_nike/nikem/sdp_logo_gfx.c src/media/tztv-media-nike/sdp_logo_nike/nikem/inc/sdp_logo_gfx.h src/media/tztv-media-nike/sdp_logo_nike/nikem/inc/sdp_logo_ga.h src/media/tztv-media-nike/sdp_logo_nike/nikem/sdp_logo_ddr.c src/media/tztv-media-nike/sdp_logo_nike/nikem/inc/sdp_logo_ddr.h src/media/tztv-media-nike/sdp_logo_nike/nikem/inc/sdp_logo_chip.h
SHOW_LINES=1-1500
REQUEST_ID=2026-11-12-070-show-bootlogo
