@@ -316,6 +316,29 @@ cec@9c0f00 {
 			samsung,mccmu = <&mccmu>;
 			status = "disabled";
 		};
+
+		/*
+		 * DRM/KMS display driver.  Reg regions from firmware dtb0
+		 * /soc/bootlogo (sha256 0189cc94), in the order sdp_drm.c
+		 * expects (OSD=0, GP=1, MIXER=2, QE=3, GA=4, POST=5, TMG=6).
+		 *
+		 * Interrupts (IRQ_TYPE_NONE – polarity set by firmware):
+		 *   [0] GIC SPI 47  (0x2f) vsync
+		 *   [1] GIC SPI 102 (0x66) 2-D blitter done (unused)
+		 */
+		drm@5d0000 {
+			compatible = "samsung,sdp-drm";
+			reg = <0x005d0000 0x4000>,	/* OSD */
+			      <0x005d4000 0x4000>,	/* GP  */
+			      <0x005d8000 0x4000>,	/* MIXER */
+			      <0x005dc000 0x40000>,	/* QE */
+			      <0x00580000 0x4000>,	/* GA */
+			      <0x00700000 0xd000>,	/* POST */
+			      <0x00c00000 0x20000>;	/* TMG */
+			interrupts = <GIC_SPI 47 IRQ_TYPE_NONE>,
+				     <GIC_SPI 102 IRQ_TYPE_NONE>;
+			status = "disabled";
+		};
 	};
 
 	/*
@@ -328,4 +351,20 @@ micom {
 		samsung,messagebox = <&msgbox>;
 		status = "disabled";
 	};
+
+	/*
+	 * Reserved memory regions from the firmware /sdp_mmap property set.
+	 * "samsung,gfx0" is the GP-plane framebuffer: physical 0xfb580000,
+	 * size 0xfd8000 (~16 MiB).  The property is a u32 triplet where
+	 * index 0 is unused, index 1 is the physical address, index 2 is the
+	 * size (matches sdp_logo_parse_exe_mem() in tztv-media-nike).
+	 *
+	 * Source: firmware dtb0 /sdp_mmap (sha256 0189cc94), X>-diff lines.
+	 */
+	sdp_mmap {
+		compatible = "samsung,sdp-mmap";
+		samsung,gfx0 = <0x0 0xfb580000 0xfd8000>;
+		samsung,gfx1 = <0x0 0xf9d80000 0x1800000>;
+	};
+
 };
