+/* ── Nike-L register map (from sdp_logo_chip.h, _NIKEL_GFX_ section) ─────
+ *
+ * REG(x) = (x) << 2   (register index → byte offset)
+ *
+ * All offsets verified against GPL source sdp_logo_chip.h lines 164–220,
+ * firmware dtb0 /soc/bootlogo reg property (sha256 0189cc94).
+ */
+#define REG(x)			((x) << 2)
+
+/* GP plane registers (base[GP_BASE], firmware 0x5d4000) */
+#define GP_DISP_MODE_0		REG(0)	/* [4:0] enable bits, [11:8] flip */
+#define GP_DISP_MODE_1		REG(1)
+#define GP_INPUT_SIZE		REG(4)	/* [31:16] width | [15:0] height */
+#define GP_OUTPUT_SIZE		REG(5)	/* [31:16] w_out | [15:0] h_out */
+#define GP_H_OFFSET		REG(6)	/* width >> 2 */
+#define GP_HOR_RATIO		REG(8)	/* horizontal scale ratio */
+#define GP_VER_RATIO		REG(9)	/* vertical scale ratio */
+#define GP_BASE_ADDR_LOW	REG(12)	/* physical framebuffer address */
+#define GP_BASE_ADDR_HIGH	REG(13)	/* upper address bits */
+
+/* Mixer registers (base[MIXER_BASE], firmware 0x5d8000) */
+#define MIX_MODE		REG(0)
+#define MIX_GFXP		REG(1)	/* pre/post mixing control */
+#define MIX_IRQ_STATUS		REG(2)	/* read-then-write-back to ack */
+#define MIX_IRQ_MASK		REG(3)	/* 0 = unmask vsync IRQ */
+#define MIX_SYNC_CONTROL	REG(5)
+#define MIX_RASTER_SIZE		REG(7)	/* [31:16] h | [15:0] v raster */
+#define MIX_SIZE		REG(8)	/* [31:16] h | [15:0] v active */
+#define MIX_POS			REG(9)	/* [31:16] x | [15:0] y */
+#define MIX_GP_ACTIVE_SIZE	REG(12)	/* [31:16] w | [15:0] h */
+#define MIX_GP_ACTIVE_POS	REG(13)	/* [31:16] x | [15:0] y */
+#define MIX_GP_BLEND_CTL	REG(22)	/* [31:16] mode | [8:0] factor */
+#define MIX_CLK_SEL		REG(104)
+
+/* Blend mode constants (from sdp_logo.h) */
+#define BLEND_MODE_SHIFT	16
+#define BLEND_FACTOR_MASK	0x1ff
+#define WINDOW_BLEND		2
 
-#define SDP_DRM_DEFAULT_WIDTH	1920
-#define SDP_DRM_DEFAULT_HEIGHT	1080
+/* Scale ratios (from sdp_logo_chip.h) – 0x8000 = 2:1 downscale */
+#define GP_UHD_RATIO_H		0x8000
+#define GP_UHD_RATIO_V		0x8000
 
+/* Active area for the GP plane (UHD: input 1920×1080 → output 3840×2160) */
+#define GP_INPUT_W		1920
+#define GP_INPUT_H		1080
+#define GP_OUTPUT_SHIFT		1		/* output = input << 1 */
+
+/* Mixer start position (from sdp_logo_chip.h) */
+#define UHD_MIXER_START_X	0x50
+#define UHD_MIXER_START_Y	0x16
+
+/* GP enable bits in DISP_MODE_0 */
+#define GP_ENABLE_BITS		0x11
+#define GP_FLIP_MASK		0xf00
+
+/* base[] indices – match the bootlogo DT reg order */
+enum sdp_drm_base {
+	OSD_BASE	= 0,
+	GP_BASE		= 1,
+	MIXER_BASE	= 2,
+	QE_BASE		= 3,
+	GA_BASE		= 4,
+	POST_BASE	= 5,
+	TMG_BASE	= 6,
+	NUM_BASE	= 7,
+};
