+/* ── helpers ─────────────────────────────────────────────────────────────── */
+
+static inline void gp_write(struct sdp_drm_device *sdp, u32 reg, u32 val)
+{
+	writel(val, sdp->base[GP_BASE] + reg);
+}
+
+static inline u32 gp_read(struct sdp_drm_device *sdp, u32 reg)
+{
+	return readl(sdp->base[GP_BASE] + reg);
+}
+
+static inline void mix_write(struct sdp_drm_device *sdp, u32 reg, u32 val)
+{
+	writel(val, sdp->base[MIXER_BASE] + reg);
+}
+
+static inline u32 mix_read(struct sdp_drm_device *sdp, u32 reg)
+{
