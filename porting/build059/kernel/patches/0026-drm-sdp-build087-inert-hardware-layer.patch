From: Codex <noreply@openai.com>
Subject: [PATCH] drm: sdp: replace experimental writes with Build 087 inert hardware layer

Keep prior patches intact; supersede their display implementation. No MMIO
reads/writes or IRQ requests. Probe remains blocked regardless of DT flags.

diff --git a/drivers/gpu/drm/sdp/sdp_drm.c b/drivers/gpu/drm/sdp/sdp_drm.c
--- a/drivers/gpu/drm/sdp/sdp_drm.c
+++ b/drivers/gpu/drm/sdp/sdp_drm.c
@@ -1,53 +1,17 @@
 // SPDX-License-Identifier: GPL-2.0-only
-/*
- * Samsung SDP Nike-L (SDP1412) display – minimal DRM/KMS driver
- *
- * Build 070, patch 0015.  Ported from the Samsung GPL sdp_logo_nike module
- * (tztv-media-nike/sdp_logo_nike, kernel 4.1.10) to the Linux 6.6 DRM/KMS
- * framework.  This is the shortest path to a picture: it drives a single
- * GP (graphic-plane) layer through the on-chip mixer, exactly the same
- * pipeline the Tizen boot-logo uses.
- *
- * Hardware blocks mapped (from firmware dtb0 /soc/bootlogo):
- *   reg index 0  OSD   0x005d0000  0x4000   (not programmed yet)
- *   reg index 1  GP    0x005d4000  0x4000   ← GP plane registers
- *   reg index 2  MIXER 0x005d8000  0x4000   ← mixer / vsync IRQ
- *   reg index 3  QE    0x005dc000  0x40000  (quality engine, bypassed)
- *   reg index 4  GA    0x00580000  0x4000   (2-D blitter, unused here)
- *   reg index 5  POST  0x00700000  0xd000   (not programmed yet)
- *   reg index 6  TMG   0x00c00000  0x20000  (timing generator, left alone)
- *
- * Framebuffer memory comes from the /sdp_mmap "samsung,gfx0" property:
- *   physical address 0xfb580000, size 0xfd8000 (~16 MiB).
- *
- * The GP plane takes a physical base address in PLANE_BASE_ADDR_LOW (reg 12)
- * and displays it through the mixer at the resolution / scaler ratio the
- * boot-firmware has already configured.  The driver keeps the existing mixer
- * and QE/POST/TMG configuration; it only programs the GP plane and reads
- * vsync from the mixer IRQ.
- *
- * NEVER FLASH THIS – compile-only until validated on the runner.
- *
- * Register offsets: sdp_logo_chip.h  (_NIKEL_GFX_ section)
- * Plane programming: sdp_logo.c      (sdp_logo_set_plane, _NIKEL_GFX_)
- * Mixer init:        sdp_logo_gfx.c  (sdp_logo_gfx_init, _NIKEL_GFX_)
- */
+/* Build 087: compile-only KMS integration. Probe is unconditionally blocked. */
 #include <linux/dma-mapping.h>
-#include <linux/interrupt.h>
-#include <linux/io.h>
+#include "sdp_drm_hw.h"
 #include <linux/mod_devicetable.h>
 #include <linux/module.h>
-#include <linux/of_address.h>
 #include <linux/platform_device.h>
 
 #include <drm/drm_atomic_helper.h>
 #include <drm/drm_connector.h>
+#include <drm/drm_drv.h>
 #include <drm/drm_edid.h>
-#include <drm/drm_drv.h>
-#include <drm/drm_fb_dma_helper.h>
 #include <drm/drm_fbdev_dma.h>
 #include <drm/drm_fourcc.h>
-#include <drm/drm_framebuffer.h>
 #include <drm/drm_gem_dma_helper.h>
 #include <drm/drm_gem_framebuffer_helper.h>
 #include <drm/drm_managed.h>
@@ -57,88 +21,12 @@
 #include <drm/drm_simple_kms_helper.h>
 #include <drm/drm_vblank.h>
 
-/* ── Nike-L register map (from sdp_logo_chip.h, _NIKEL_GFX_ section) ─────
- *
- * REG(x) = (x) << 2   (register index → byte offset)
- *
- * All offsets verified against GPL source sdp_logo_chip.h lines 164–220,
- * firmware dtb0 /soc/bootlogo reg property (sha256 0189cc94).
- */
-#define REG(x)			((x) << 2)
-
-/* GP plane registers (base[GP_BASE], firmware 0x5d4000) */
-#define GP_DISP_MODE_0		REG(0)	/* [4:0] enable bits, [11:8] flip */
-#define GP_DISP_MODE_1		REG(1)
-#define GP_INPUT_SIZE		REG(4)	/* [31:16] width | [15:0] height */
-#define GP_OUTPUT_SIZE		REG(5)	/* [31:16] w_out | [15:0] h_out */
-#define GP_H_OFFSET		REG(6)	/* width >> 2 */
-#define GP_HOR_RATIO		REG(8)	/* horizontal scale ratio */
-#define GP_VER_RATIO		REG(9)	/* vertical scale ratio */
-#define GP_BASE_ADDR_LOW	REG(12)	/* physical framebuffer address */
-#define GP_BASE_ADDR_HIGH	REG(13)	/* upper address bits */
-
-/* Mixer registers (base[MIXER_BASE], firmware 0x5d8000) */
-#define MIX_MODE		REG(0)
-#define MIX_GFXP		REG(1)	/* pre/post mixing control */
-#define MIX_IRQ_STATUS		REG(2)	/* read-then-write-back to ack */
-#define MIX_IRQ_MASK		REG(3)	/* 0 = unmask vsync IRQ */
-#define MIX_SYNC_CONTROL	REG(5)
-#define MIX_RASTER_SIZE		REG(7)	/* [31:16] h | [15:0] v raster */
-#define MIX_SIZE		REG(8)	/* [31:16] h | [15:0] v active */
-#define MIX_POS			REG(9)	/* [31:16] x | [15:0] y */
-#define MIX_GP_ACTIVE_SIZE	REG(12)	/* [31:16] w | [15:0] h */
-#define MIX_GP_ACTIVE_POS	REG(13)	/* [31:16] x | [15:0] y */
-#define MIX_GP_BLEND_CTL	REG(22)	/* [31:16] mode | [8:0] factor */
-#define MIX_CLK_SEL		REG(104)
-
-/* Blend mode constants (from sdp_logo.h) */
-#define BLEND_MODE_SHIFT	16
-#define BLEND_FACTOR_MASK	0x1ff
-#define WINDOW_BLEND		2
-
-/* Scale ratios (from sdp_logo_chip.h) – 0x8000 = 2:1 downscale */
-#define GP_UHD_RATIO_H		0x8000
-#define GP_UHD_RATIO_V		0x8000
-
-/* Active area for the GP plane (UHD: input 1920×1080 → output 3840×2160) */
-#define GP_INPUT_W		1920
-#define GP_INPUT_H		1080
-#define GP_OUTPUT_SHIFT		1		/* output = input << 1 */
-
-/* Mixer start position (from sdp_logo_chip.h) */
-#define UHD_MIXER_START_X	0x50
-#define UHD_MIXER_START_Y	0x16
-
-/* GP enable bits in DISP_MODE_0 */
-#define GP_ENABLE_BITS		0x11
-#define GP_FLIP_MASK		0xf00
-
-/* base[] indices – match the bootlogo DT reg order */
-enum sdp_drm_base {
-	OSD_BASE	= 0,
-	GP_BASE		= 1,
-	MIXER_BASE	= 2,
-	QE_BASE		= 3,
-	GA_BASE		= 4,
-	POST_BASE	= 5,
-	TMG_BASE	= 6,
-	NUM_BASE	= 7,
-};
-
-/**
- * struct sdp_drm_device - driver private state
- * @drm: DRM device
- * @base: ioremapped register blocks (indexed by enum sdp_drm_base)
- * @fb_phys: physical address of the reserved framebuffer (from sdp_mmap)
- * @fb_size: size of the reserved framebuffer in bytes
- * @pipe: DRM simple display pipe
- * @connector: DRM connector (fixed mode, always connected)
- */
+#define SDP_DRM_DEFAULT_WIDTH	1920
+#define SDP_DRM_DEFAULT_HEIGHT	1080
+
 struct sdp_drm_device {
 	struct drm_device drm;
-	void __iomem *base[NUM_BASE];
-	u32 fb_phys;
-	u32 fb_size;
+	struct sdp_hw hw;
 	struct drm_simple_display_pipe pipe;
 	struct drm_connector connector;
 };
@@ -148,384 +36,115 @@
 	DRM_FORMAT_ARGB8888,
 };
 
-/* Scanout only accepts the linear layout documented by the boot-logo path. */
+/* Connector: expose one fixed mode. TODO: read real Nike-L panel timing. */
+static int sdp_drm_conn_get_modes(struct drm_connector *connector)
+{
+	int count;
+
+	count = drm_add_modes_noedid(connector, SDP_DRM_DEFAULT_WIDTH,
+				     SDP_DRM_DEFAULT_HEIGHT);
+	drm_set_preferred_mode(connector, SDP_DRM_DEFAULT_WIDTH,
+			       SDP_DRM_DEFAULT_HEIGHT);
+	return count;
+}
+
+static const struct drm_connector_helper_funcs sdp_drm_conn_helper_funcs = {
+	.get_modes = sdp_drm_conn_get_modes,
+};
+
+static const struct drm_connector_funcs sdp_drm_conn_funcs = {
+	.fill_modes = drm_helper_probe_single_connector_modes,
+	.destroy = drm_connector_cleanup,
+	.reset = drm_atomic_helper_connector_reset,
+	.atomic_duplicate_state = drm_atomic_helper_connector_duplicate_state,
+	.atomic_destroy_state = drm_atomic_helper_connector_destroy_state,
+};
+
+/* Simple display pipe: all hardware steps are TODO for a real bring-up. */
+static void sdp_drm_pipe_enable(struct drm_simple_display_pipe *pipe,
+				struct drm_crtc_state *crtc_state,
+				struct drm_plane_state *plane_state)
+{
+	/* TODO: program the Nike-L display controller and enable the output. */
+}
+
+static void sdp_drm_pipe_disable(struct drm_simple_display_pipe *pipe)
+{
+	/* TODO: blank the Nike-L display controller. */
+}
+
+static void sdp_drm_pipe_update(struct drm_simple_display_pipe *pipe,
+				struct drm_plane_state *old_state)
+{
+	/* TODO: flip to the new framebuffer and signal VSync/vblank. */
+}
+
+static int sdp_drm_pipe_check(struct drm_simple_display_pipe *pipe,
+			      struct drm_plane_state *state,
+			      struct drm_crtc_state *crtc_state)
+{
+	struct sdp_scanout prepared;
+
+	if (!state->fb)
+		return 0;
+	return sdp_hw_prepare_plane(state, crtc_state, &prepared);
+}
+
+static int sdp_drm_enable_vblank(struct drm_simple_display_pipe *pipe)
+{
+	return sdp_hw_enable_vblank();
+}
+
+static void sdp_drm_disable_vblank(struct drm_simple_display_pipe *pipe)
+{
+	sdp_hw_disable_vblank();
+}
+
 static const u64 sdp_drm_modifiers[] = {
 	DRM_FORMAT_MOD_LINEAR,
 	DRM_FORMAT_MOD_INVALID,
 };
 
-/* ── helpers ─────────────────────────────────────────────────────────────── */
-
-static inline void gp_write(struct sdp_drm_device *sdp, u32 reg, u32 val)
-{
-	writel(val, sdp->base[GP_BASE] + reg);
-}
-
-static inline u32 gp_read(struct sdp_drm_device *sdp, u32 reg)
-{
-	return readl(sdp->base[GP_BASE] + reg);
-}
-
-static inline void mix_write(struct sdp_drm_device *sdp, u32 reg, u32 val)
-{
-	writel(val, sdp->base[MIXER_BASE] + reg);
-}
-
-static inline u32 mix_read(struct sdp_drm_device *sdp, u32 reg)
-{
-	return readl(sdp->base[MIXER_BASE] + reg);
-}
-
-/* ── connector: one fixed mode, always connected ────────────────────────── */
-
-/**
- * sdp_drm_conn_get_modes() - expose a single 1920×1080 mode
- * @connector: DRM connector
- *
- * The Q60T panel reports 1920×1080 in the firmware DT display-timings
- * (hactive=0x780, vactive=0x438).  The mixer scales to 3840×2160 with
- * a 2:1 ratio; userspace sees the native 1920×1080.
- *
- * Return: number of modes added.
- */
-static int sdp_drm_conn_get_modes(struct drm_connector *connector)
-{
-	int count;
-
-	count = drm_add_modes_noedid(connector, GP_INPUT_W, GP_INPUT_H);
-	drm_set_preferred_mode(connector, GP_INPUT_W, GP_INPUT_H);
-	return count;
-}
-
-static const struct drm_connector_helper_funcs sdp_drm_conn_helper = {
-	.get_modes = sdp_drm_conn_get_modes,
-};
-
-static const struct drm_connector_funcs sdp_drm_conn_funcs = {
-	.fill_modes		= drm_helper_probe_single_connector_modes,
-	.destroy		= drm_connector_cleanup,
-	.reset			= drm_atomic_helper_connector_reset,
-	.atomic_duplicate_state	= drm_atomic_helper_connector_duplicate_state,
-	.atomic_destroy_state	= drm_atomic_helper_connector_destroy_state,
-};
-
-/* ── display pipe: GP plane + mixer ─────────────────────────────────────── */
-
-/*
- * sdp_logo.c:296-301 derives H_OFFSET from width, not arbitrary pitches.
- * Only the boot-logo dimensions are implemented; never accept an oversized
- * or cropped FB and then silently scan it with a 1920-pixel stride.
- */
-static enum drm_mode_status
-sdp_drm_mode_valid(struct drm_simple_display_pipe *pipe,
-		   const struct drm_display_mode *mode)
-{
-	if (mode->hdisplay != GP_INPUT_W || mode->vdisplay != GP_INPUT_H)
-		return MODE_BAD;
-	if (mode->flags & (DRM_MODE_FLAG_INTERLACE | DRM_MODE_FLAG_DBLSCAN))
-		return MODE_BAD;
-	return MODE_OK;
-}
-
-static int sdp_drm_pipe_check(struct drm_simple_display_pipe *pipe,
-			    struct drm_plane_state *state,
-			    struct drm_crtc_state *crtc_state)
-{
-	struct drm_framebuffer *fb = state->fb;
-	dma_addr_t addr;
-	u64 last;
-
-	if (!fb)
-		return 0;
-	if (fb->width != GP_INPUT_W || fb->height != GP_INPUT_H ||
-	    fb->pitches[0] != GP_INPUT_W * 4 ||
-	    fb->modifier != DRM_FORMAT_MOD_LINEAR || state->src_x || state->src_y)
-		return -EINVAL;
-	addr = drm_fb_dma_get_gem_addr(fb, state, 0);
-	last = (u64)addr + (u64)fb->pitches[0] * fb->height - 1;
-	/* Only BASE_ADDR_LOW is ported; do not truncate a high DMA address. */
-	if (last > U32_MAX)
-		return -EINVAL;
-	return 0;
-}
-
-/**
- * sdp_drm_pipe_enable() - turn on the GP plane and mixer output
- * @pipe: simple display pipe
- * @crtc_state: CRTC state (unused, mode is fixed)
- * @plane_state: plane state with the framebuffer to display
- *
- * Programs the GP plane with the framebuffer address, size, scale ratios
- * and position, then enables the plane.  Mixer and QE/POST/TMG are left
- * in whatever state the boot firmware set.
- *
- * Register sequence reconstructed from sdp_logo_gfx_init() and
- * sdp_logo_set_plane() in sdp_logo_nike/nikem/ (GPL, _NIKEL_GFX_ path).
- */
-static void sdp_drm_pipe_enable(struct drm_simple_display_pipe *pipe,
-				struct drm_crtc_state *crtc_state,
-				struct drm_plane_state *plane_state)
-{
-	struct sdp_drm_device *sdp = container_of(pipe, struct sdp_drm_device,
-						   pipe);
-	struct drm_framebuffer *fb = plane_state->fb;
-	struct drm_gem_dma_object *gem;
-	u32 addr, val;
-
-	if (!fb)
-		return;
-
-	gem = drm_fb_dma_get_gem_obj(fb, 0);
-	if (!gem)
-		return;
-
-	addr = (u32)drm_fb_dma_get_gem_addr(fb, plane_state, 0);
-
-	/* GP plane: H_OFFSET = width >> 2 */
-	gp_write(sdp, GP_H_OFFSET, GP_INPUT_W >> 2);
-
-	/* GP plane: input size (packed: width<<16 | height) */
-	gp_write(sdp, GP_INPUT_SIZE,
-		 (GP_INPUT_W << 16) | GP_INPUT_H);
-
-	/* GP plane: output size = input << GP_OUTPUT_SHIFT (2× for UHD) */
-	val = ((GP_INPUT_W << GP_OUTPUT_SHIFT) << 16) |
-	       (GP_INPUT_H << GP_OUTPUT_SHIFT);
-	gp_write(sdp, GP_OUTPUT_SIZE, val);
-
-	/* GP plane: scale ratios (0x8000 = 2:1 downscale) */
-	gp_write(sdp, GP_HOR_RATIO, GP_UHD_RATIO_H);
-	gp_write(sdp, GP_VER_RATIO, GP_UHD_RATIO_V);
-
-	/* Mixer: GP active size = output size */
-	mix_write(sdp, MIX_GP_ACTIVE_SIZE, val);
-
-	/* Mixer: position */
-	mix_write(sdp, MIX_POS,
-		  (UHD_MIXER_START_X << 16) | UHD_MIXER_START_Y);
-
-	/* GP plane: framebuffer physical address */
-	gp_write(sdp, GP_BASE_ADDR_LOW, addr);
-
-	/* GP plane: no flip, clear flip bits then enable */
-	val = gp_read(sdp, GP_DISP_MODE_0);
-	val &= ~GP_FLIP_MASK;
-	val |= GP_ENABLE_BITS;
-	gp_write(sdp, GP_DISP_MODE_0, val);
-
-	/* Mixer: blend – window blend, full opacity */
-	mix_write(sdp, MIX_GP_BLEND_CTL,
-		  (WINDOW_BLEND << BLEND_MODE_SHIFT) |
-		  (0xff & BLEND_FACTOR_MASK));
-
-	/* Pair with vblank_off before disabling the plane. */
-	drm_crtc_vblank_on(&pipe->crtc);
-}
-
-/**
- * sdp_drm_pipe_disable() - blank the GP plane
- * @pipe: simple display pipe
- *
- * Clears the enable bits in GP DISP_MODE_0 and masks the vsync IRQ.
- * Mixer/POST/TMG are left running – the panel stays on but shows black.
- */
-static void sdp_drm_pipe_disable(struct drm_simple_display_pipe *pipe)
-{
-	struct sdp_drm_device *sdp = container_of(pipe, struct sdp_drm_device,
-						   pipe);
-	u32 val;
-
-	drm_crtc_vblank_off(&pipe->crtc);
-
-	/* Disable GP plane */
-	val = gp_read(sdp, GP_DISP_MODE_0);
-	val &= ~GP_ENABLE_BITS;
-	gp_write(sdp, GP_DISP_MODE_0, val);
-
-	/* Mask vsync IRQ */
-	mix_write(sdp, MIX_IRQ_MASK, 0x1);
-}
-
-/**
- * sdp_drm_pipe_update() - flip to a new framebuffer
- * @pipe: simple display pipe
- * @old_state: previous plane state
- *
- * Writes the new framebuffer's physical address into GP_BASE_ADDR_LOW.
- * The flip takes effect at the next vsync (the mixer latches on the
- * rising edge of the internal sync).
- */
-static void sdp_drm_pipe_update(struct drm_simple_display_pipe *pipe,
-				struct drm_plane_state *old_state)
-{
-	struct sdp_drm_device *sdp = container_of(pipe, struct sdp_drm_device,
-						   pipe);
-	struct drm_plane_state *state = pipe->plane.state;
-	struct drm_framebuffer *fb = state->fb;
-	struct drm_gem_dma_object *gem;
-
-	if (!fb)
-		return;
-
-	gem = drm_fb_dma_get_gem_obj(fb, 0);
-	if (!gem)
-		return;
-
-	gp_write(sdp, GP_BASE_ADDR_LOW,
-		 (u32)drm_fb_dma_get_gem_addr(fb, state, 0));
-
-	if (pipe->crtc.state->event) {
-		struct drm_pending_vblank_event *event = pipe->crtc.state->event;
-
-		spin_lock_irq(&pipe->crtc.dev->event_lock);
-		pipe->crtc.state->event = NULL;
-		if (drm_crtc_vblank_get(&pipe->crtc) == 0)
-			drm_crtc_arm_vblank_event(&pipe->crtc, event);
-		else
-			drm_crtc_send_vblank_event(&pipe->crtc, event);
-		spin_unlock_irq(&pipe->crtc.dev->event_lock);
-	}
-}
-
-static int sdp_drm_enable_vblank(struct drm_simple_display_pipe *pipe)
-{
-	struct sdp_drm_device *sdp = container_of(pipe, struct sdp_drm_device, pipe);
-
-	/* Samsung sdp_logo_gfx.c:83-85, NIKEL IRQ unmask value. */
-	mix_write(sdp, MIX_IRQ_MASK, 0);
-	return 0;
-}
-
-static void sdp_drm_disable_vblank(struct drm_simple_display_pipe *pipe)
-{
-	struct sdp_drm_device *sdp = container_of(pipe, struct sdp_drm_device, pipe);
-
-	/* Samsung sdp_drm_nike/gfx/nikel/sdp_mixer.c:137-146. */
-	mix_write(sdp, MIX_IRQ_MASK, 1);
-}
-
 static const struct drm_simple_display_pipe_funcs sdp_drm_pipe_funcs = {
-	.mode_valid	= sdp_drm_mode_valid,
-	.check		= sdp_drm_pipe_check,
-	.enable_vblank	= sdp_drm_enable_vblank,
-	.disable_vblank	= sdp_drm_disable_vblank,
-	.enable		= sdp_drm_pipe_enable,
-	.disable	= sdp_drm_pipe_disable,
-	.update		= sdp_drm_pipe_update,
-};
-
-/* ── vsync IRQ ──────────────────────────────────────────────────────────── */
-
-/**
- * sdp_drm_irq() - mixer vsync interrupt handler
- * @irq: interrupt number
- * @data: pointer to struct sdp_drm_device
- *
- * Acknowledges the mixer vsync IRQ by reading MIX_IRQ_STATUS and writing
- * it back (as done in sdp_logo vsync_irq_handler).
- *
- * Return: IRQ_HANDLED.
- */
-static irqreturn_t sdp_drm_irq(int irq, void *data)
-{
-	struct sdp_drm_device *sdp = data;
-	u32 status;
-
-	status = mix_read(sdp, MIX_IRQ_STATUS);
-	if (!status)
-		return IRQ_NONE;
-	mix_write(sdp, MIX_IRQ_STATUS, status);
-
-	drm_crtc_handle_vblank(&sdp->pipe.crtc);
-
-	return IRQ_HANDLED;
-}
-
-/* ── mode config ────────────────────────────────────────────────────────── */
+	.check = sdp_drm_pipe_check,
+	.enable_vblank = sdp_drm_enable_vblank,
+	.disable_vblank = sdp_drm_disable_vblank,
+	.enable = sdp_drm_pipe_enable,
+	.disable = sdp_drm_pipe_disable,
+	.update = sdp_drm_pipe_update,
+};
 
 static const struct drm_mode_config_funcs sdp_drm_mode_config_funcs = {
-	.fb_create	= drm_gem_fb_create,
-	.atomic_check	= drm_atomic_helper_check,
-	.atomic_commit	= drm_atomic_helper_commit,
+	.fb_create = drm_gem_fb_create,
+	.atomic_check = drm_atomic_helper_check,
+	.atomic_commit = drm_atomic_helper_commit,
 };
 
 DEFINE_DRM_GEM_DMA_FOPS(sdp_drm_fops);
 
 static const struct drm_driver sdp_drm_driver = {
-	.driver_features	= DRIVER_GEM | DRIVER_MODESET | DRIVER_ATOMIC,
-	.fops			= &sdp_drm_fops,
+	.driver_features = DRIVER_GEM | DRIVER_MODESET | DRIVER_ATOMIC,
+	.fops = &sdp_drm_fops,
 	DRM_GEM_DMA_DRIVER_OPS,
-	.name			= "sdp-drm",
-	.desc			= "Samsung SDP Nike-L display",
-	.date			= "20261112",
-	.major			= 0,
-	.minor			= 2,
-};
-
-/* ── platform driver ────────────────────────────────────────────────────── */
-
-/**
- * sdp_drm_parse_gfx_mem() - read framebuffer address from /sdp_mmap
- * @dev: platform device
- * @addr: returned physical address
- * @size: returned size in bytes
- *
- * The Samsung SDP SoC places reserved memory regions in a /sdp_mmap
- * device-tree node as named u32[3] properties (index 0 is unused,
- * index 1 is the physical address, index 2 is the size).  The GP plane's
- * framebuffer is "samsung,gfx0".
- *
- * Return: 0 on success, negative errno on failure.
- */
-static int sdp_drm_parse_gfx_mem(struct device *dev, u32 *addr, u32 *size)
-{
