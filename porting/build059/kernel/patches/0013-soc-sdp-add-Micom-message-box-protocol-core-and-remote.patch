+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung SDP (Nike-L) Micom protocol core.
+ *
+ * The Micom standby controller decodes the IR remote, the front panel keys
+ * and HDMI-CEC and talks to the main CPU over the message box with short
+ * packets:
+ *   normal   FF FF cmd d0..d4 sum          (9 bytes, sum of bytes 2..7)
+ *   extended FF F9 cmdH cmdL seqH seqL len sum data..  (up to 28 bytes)
+ *   CEC      FE .. (from the Micom: FF FE hdr.. xor)
+ * This driver checks and dispatches incoming packets to client drivers
+ * (IR remote, panel keys, CEC, generic messages) and sends commands.
+ *
+ * Linux 6.6 port of tztv-micom/sdp_micom_messagebox.c and sdp_micom.h from
+ * Samsung's GPL package 20_DTV_NikeL (Copyright (C) 2013 Samsung
+ * Electronics Co. Ltd., GPL-2.0). Not ported: hotel/HD protocol, ISP,
+ * auto-remocon, clone data, debug print thread, power-off/restart hooks.
+ */
+#include <linux/completion.h>
+#include <linux/device.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/soc/sdp/sdp-micom.h>
+#include <linux/spinlock.h>
+
+#define PREFIX			0xFF
+#define PREFIX_CEC		0xFE
+#define PREFIX_EXTENDED		0xF9
+
+#define NORMAL_LEN		9	/* FF FF cmd d0..d4 sum */
+#define NORMAL_DATA		6	/* cmd + 5 data bytes, checksummed */
+#define HEADER_LEN		2
+#define EXT_LEN_IDX		6	/* buf[6] = extended payload length */
+#define EXT_SUM_IDX		7
+#define CMD_DATA_MAX		5
+
+struct sdp_micom_client_slot {
+	sdp_micom_cb_t cb;
+	void *priv;
+};
+
+struct sdp_micom {
+	struct device *dev;
+	struct sdp_msgbox *mb;
+
+	spinlock_t clients_lock;
+	struct sdp_micom_client_slot client[SDP_MICOM_CLIENT_NUM];
+	enum sdp_micom_client last_key_client;
+
+	struct mutex cmd_lock;		/* one command with ack at a time */
+	spinlock_t ack_lock;
+	u8 ack_wanted;			/* 0 = none */
+	u8 ack_data[CMD_DATA_MAX];
+	struct completion ack_done;
+};
+
+static void sdp_micom_dispatch(struct sdp_micom *micom,
+			       enum sdp_micom_client id,
+			       const struct sdp_micom_msg *msg)
+{
+	struct sdp_micom_client_slot slot;
+	unsigned long flags;
+
+	spin_lock_irqsave(&micom->clients_lock, flags);
+	slot = micom->client[id];
+	spin_unlock_irqrestore(&micom->clients_lock, flags);
+
+	if (slot.cb)
+		slot.cb(msg, slot.priv);
+	else
+		dev_dbg(micom->dev, "no client %d for 0x%02x\n", id, msg->data[0]);
+}
+
+static void sdp_micom_check_ack(struct sdp_micom *micom,
+				const struct sdp_micom_msg *msg)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&micom->ack_lock, flags);
+	if (micom->ack_wanted &&
+	    (msg->data[0] == micom->ack_wanted ||
+	     msg->data[0] == SDP_MICOM_ACK_UNKNOWN)) {
+		memcpy(micom->ack_data, &msg->data[1], CMD_DATA_MAX);
+		micom->ack_wanted = 0;
+		complete(&micom->ack_done);
+	}
+	spin_unlock_irqrestore(&micom->ack_lock, flags);
+}
+
+static void sdp_micom_handle_normal(struct sdp_micom *micom,
+				    struct sdp_micom_msg *msg)
+{
+	switch (msg->data[0]) {
+	case SDP_MICOM_EVT_KEY_UNDEFINED:
+		msg->data[1] = SDP_MICOM_KEY_UNDEFINED;
+		fallthrough;
+	case SDP_MICOM_EVT_KEYPRESS:
+		micom->last_key_client = SDP_MICOM_CLIENT_IR;
+		sdp_micom_dispatch(micom, SDP_MICOM_CLIENT_IR, msg);
+		break;
+	case SDP_MICOM_EVT_PANEL_KEYPRESS:
+		micom->last_key_client = SDP_MICOM_CLIENT_PANEL;
+		sdp_micom_dispatch(micom, SDP_MICOM_CLIENT_PANEL, msg);
+		break;
+	case SDP_MICOM_EVT_KEYRELEASE:
+		/* release goes to whoever got the last press */
+		sdp_micom_dispatch(micom, micom->last_key_client, msg);
+		break;
+	default:
+		sdp_micom_dispatch(micom, SDP_MICOM_CLIENT_MSG, msg);
+		break;
+	}
+	sdp_micom_check_ack(micom, msg);
+}
+
+/* message box receive callback: runs in the message box IRQ thread */
+static void sdp_micom_rx(void *priv, const u8 *buf, size_t len)
+{
+	struct sdp_micom *micom = priv;
+	struct sdp_micom_msg msg = { };
+	u8 sum = 0;
+	unsigned int i;
+
+	if (len < NORMAL_LEN || buf[0] != PREFIX) {
+		dev_dbg(micom->dev, "ignoring %zu-byte packet %02x %02x\n",
+			len, buf[0], len > 1 ? buf[1] : 0);
+		return;
+	}
+
+	switch (buf[1]) {
+	case PREFIX:
+		msg.type = SDP_MICOM_MSG_NORMAL;
+		msg.len = NORMAL_DATA;
+		memcpy(msg.data, &buf[HEADER_LEN], msg.len);
+		for (i = 0; i < msg.len; i++)
+			sum += msg.data[i];
+		if (sum != buf[HEADER_LEN + msg.len])
+			goto bad_sum;
+		sdp_micom_handle_normal(micom, &msg);
+		return;
+
+	case PREFIX_EXTENDED:
+		msg.type = SDP_MICOM_MSG_EXTENDED;
+		msg.len = min_t(unsigned int, NORMAL_DATA + buf[EXT_LEN_IDX],
+				len - HEADER_LEN);
+		memcpy(msg.data, &buf[HEADER_LEN], msg.len);
+		for (i = 0; i < msg.len; i++)
+			sum += msg.data[i];
+		sum -= msg.data[EXT_SUM_IDX - HEADER_LEN];	/* own sum byte */
+		if (sum != buf[EXT_SUM_IDX])
+			goto bad_sum;
+		sdp_micom_dispatch(micom, SDP_MICOM_CLIENT_MSG, &msg);
+		return;
+
+	case PREFIX_CEC:
+		msg.type = SDP_MICOM_MSG_CEC;
+		msg.len = (buf[HEADER_LEN] & 0x1f) + 1;
+		if (HEADER_LEN + msg.len >= len)
+			goto bad_len;
+		memcpy(msg.data, &buf[HEADER_LEN], msg.len);
+		for (i = 0; i < msg.len; i++)
+			sum ^= msg.data[i];
+		if (sum != buf[HEADER_LEN + msg.len])
+			goto bad_sum;
+		sdp_micom_dispatch(micom, SDP_MICOM_CLIENT_CEC, &msg);
+		return;
+
+	default:
+		dev_err_ratelimited(micom->dev, "invalid prefix 0x%02x\n", buf[1]);
+		return;
+	}
+
+bad_len:
+	dev_err_ratelimited(micom->dev, "bad CEC packet length\n");
+	return;
+bad_sum:
+	dev_err_ratelimited(micom->dev, "checksum error (type %d, cmd 0x%02x)\n",
+			    msg.type, msg.data[0]);
+}
+
+/**
+ * sdp_micom_get - Micom of a client device created by this driver
+ */
+struct sdp_micom *sdp_micom_get(struct device *child)
+{
+	struct sdp_micom *micom = child->parent ?
+				  dev_get_drvdata(child->parent) : NULL;
+
+	return micom ?: ERR_PTR(-EPROBE_DEFER);
+}
+EXPORT_SYMBOL_GPL(sdp_micom_get);
+
+int sdp_micom_register_client(struct sdp_micom *micom,
+			      enum sdp_micom_client id, sdp_micom_cb_t cb,
+			      void *priv)
+{
+	unsigned long flags;
+	int ret = 0;
+
+	if (id >= SDP_MICOM_CLIENT_NUM || !cb)
+		return -EINVAL;
+
+	spin_lock_irqsave(&micom->clients_lock, flags);
+	if (micom->client[id].cb) {
+		ret = -EBUSY;
+	} else {
+		micom->client[id].cb = cb;
+		micom->client[id].priv = priv;
+	}
+	spin_unlock_irqrestore(&micom->clients_lock, flags);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(sdp_micom_register_client);
+
+void sdp_micom_unregister_client(struct sdp_micom *micom,
+				 enum sdp_micom_client id)
+{
+	unsigned long flags;
+
+	if (id >= SDP_MICOM_CLIENT_NUM)
+		return;
+
+	spin_lock_irqsave(&micom->clients_lock, flags);
+	micom->client[id].cb = NULL;
+	micom->client[id].priv = NULL;
+	spin_unlock_irqrestore(&micom->clients_lock, flags);
+}
+EXPORT_SYMBOL_GPL(sdp_micom_unregister_client);
+
+/**
+ * sdp_micom_send_cmd - send a normal 9-byte command (no ack wait)
+ */
+int sdp_micom_send_cmd(struct sdp_micom *micom, u8 cmd, const u8 *data,
+		       size_t len)
+{
+	u8 buf[NORMAL_LEN] = { PREFIX, PREFIX, cmd };
+	unsigned int i;
+
+	if (len > CMD_DATA_MAX)
+		return -EINVAL;
+	if (data && len)
+		memcpy(&buf[3], data, len);
+	for (i = HEADER_LEN; i < NORMAL_LEN - 1; i++)
+		buf[NORMAL_LEN - 1] += buf[i];
+
+	return sdp_msgbox_send(micom->mb, buf, sizeof(buf));
+}
+EXPORT_SYMBOL_GPL(sdp_micom_send_cmd);
+
+/**
+ * sdp_micom_send_cmd_ack - send a command and wait for its ack
+ * @ack_data: optional, receives the 5 data bytes of the ack
+ */
+int sdp_micom_send_cmd_ack(struct sdp_micom *micom, u8 cmd, u8 ack,
+			   const u8 *data, size_t len, u8 *ack_data,
+			   unsigned int timeout_ms)
+{
+	unsigned long flags;
+	int ret;
+
+	mutex_lock(&micom->cmd_lock);
+	spin_lock_irqsave(&micom->ack_lock, flags);
+	micom->ack_wanted = ack;
+	reinit_completion(&micom->ack_done);
+	spin_unlock_irqrestore(&micom->ack_lock, flags);
+
+	ret = sdp_micom_send_cmd(micom, cmd, data, len);
+	if (!ret && !wait_for_completion_timeout(&micom->ack_done,
+						 msecs_to_jiffies(timeout_ms)))
+		ret = -ETIMEDOUT;
+
+	spin_lock_irqsave(&micom->ack_lock, flags);
+	micom->ack_wanted = 0;
+	if (!ret && ack_data)
+		memcpy(ack_data, micom->ack_data, CMD_DATA_MAX);
+	spin_unlock_irqrestore(&micom->ack_lock, flags);
+	mutex_unlock(&micom->cmd_lock);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(sdp_micom_send_cmd_ack);
+
+static void sdp_micom_unregister_child(void *pdev)
+{
+	platform_device_unregister(pdev);
+}
+
+static void sdp_micom_detach(void *data)
+{
+	struct sdp_micom *micom = data;
+
+	sdp_msgbox_set_rx_callback(micom->mb, NULL, NULL);
+}
+
+static int sdp_micom_probe(struct platform_device *pdev)
+{
+	static const char * const children[] = { "sdp-micom-rc" };
+	struct device *dev = &pdev->dev;
+	struct sdp_micom *micom;
+	struct platform_device *child;
+	unsigned int i;
+	int ret;
+
+	micom = devm_kzalloc(dev, sizeof(*micom), GFP_KERNEL);
+	if (!micom)
+		return -ENOMEM;
+
+	micom->dev = dev;
+	spin_lock_init(&micom->clients_lock);
+	spin_lock_init(&micom->ack_lock);
+	mutex_init(&micom->cmd_lock);
+	init_completion(&micom->ack_done);
+	micom->last_key_client = SDP_MICOM_CLIENT_IR;
+
+	micom->mb = sdp_msgbox_get(dev, dev->of_node);
+	if (IS_ERR(micom->mb))
+		return dev_err_probe(dev, PTR_ERR(micom->mb),
+				     "no message box\n");
+
+	platform_set_drvdata(pdev, micom);
+
+	ret = sdp_msgbox_set_rx_callback(micom->mb, sdp_micom_rx, micom);
+	if (ret)
+		return dev_err_probe(dev, ret, "message box is in use\n");
+	ret = devm_add_action_or_reset(dev, sdp_micom_detach, micom);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < ARRAY_SIZE(children); i++) {
+		child = platform_device_register_data(dev, children[i],
+						      PLATFORM_DEVID_AUTO,
+						      NULL, 0);
+		if (IS_ERR(child))
+			return dev_err_probe(dev, PTR_ERR(child),
+					     "cannot add %s\n", children[i]);
+		ret = devm_add_action_or_reset(dev, sdp_micom_unregister_child,
+					       child);
+		if (ret)
+			return ret;
+	}
+
+	dev_info(dev, "Micom protocol core\n");
+	return 0;
+}
+
+static const struct of_device_id sdp_micom_of_match[] = {
+	{ .compatible = "samsung,tztv-micom" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sdp_micom_of_match);
+
+static struct platform_driver sdp_micom_driver = {
+	.probe = sdp_micom_probe,
+	.driver = {
+		.name = "sdp-micom",
+		.of_match_table = sdp_micom_of_match,
+		.suppress_bind_attrs = true,
+	},
+};
+module_platform_driver(sdp_micom_driver);
+
+MODULE_DESCRIPTION("Samsung SDP Micom protocol core");
+MODULE_LICENSE("GPL");
diff --git a/drivers/soc/sdp/sdp-msgbox.c b/drivers/soc/sdp/sdp-msgbox.c
new file mode 100644
index 000000000..2a755e58e
--- /dev/null
+++ b/drivers/soc/sdp/sdp-msgbox.c
@@ -0,0 +1,303 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung SDP (Nike-L) Micom message box.
+ *
+ * Hardware mailbox between the main CPU and the Micom standby controller
+ * (DT "samsung,sdp-messagebox"). Each direction has eight 32-bit data
+ * registers (word 0 = payload length, words 1..7 = up to 28 payload bytes),
+ * a pending register and a clear register.
+ *
+ * Linux 6.6 port of linux-4.1.10/drivers/mailbox/sdp_micom_msgbox.c from
+ * Samsung's GPL package 20_DTV_NikeL (douk.namm@samsung.com, 2014-2019,
+ * version 1.3). Changes: per-device state instead of globals, kfifo instead
+ * of the open-coded ring, consumers find the box via a DT phandle; the
+ * delayed-IRQ recovery timer, debugfs statistics and VD-ramdump trigger of
+ * the original are not ported.
+ */
+#include <linux/device.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/kfifo.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/delay.h>
+#include <linux/soc/sdp/sdp-micom.h>
+#include <linux/spinlock.h>
+
+/* register layout, from the Samsung driver */
+#define RECV_DATA(n)		(0x00 + 4 * (n))
+#define RECV_PEND		0x40
+#define RECV_CLEAR		0x44
+#define SEND_DATA(n)		(0x80 + 4 * (n))
+#define SEND_PEND		0xc0
+#define SEND_CLEAR		0xc4
+
+#define MSG_SEND		BIT(0)
+#define MSG_ALL_PENDING		0xff
+
+#define RX_FIFO_DEPTH		16	/* messages, as SDP_MC_HANDLER_RINGBUF_SIZE */
+#define SEND_WAIT_MS		50
+
+struct sdp_msgbox_rx {
+	u32 word[8];
+};
+
+struct sdp_msgbox {
+	struct device *dev;
+	void __iomem *base;
+	int irq;
+
+	spinlock_t rx_lock;		/* ISR <-> thread FIFO */
+	DECLARE_KFIFO(rx_fifo, struct sdp_msgbox_rx, RX_FIFO_DEPTH);
+	struct mutex send_lock;
+
+	spinlock_t cb_lock;		/* rx_cb / rx_priv */
+	sdp_msgbox_rx_cb_t rx_cb;
+	void *rx_priv;
+
+	unsigned int rx_dropped;
+};
+
+static irqreturn_t sdp_msgbox_isr(int irq, void *data)
+{
+	struct sdp_msgbox *mb = data;
+	struct sdp_msgbox_rx rx;
+	irqreturn_t ret = IRQ_NONE;
+	u32 pend;
+	int i;
+
+	pend = readl(mb->base + RECV_PEND);
+	if (!pend) {
+		writel(MSG_ALL_PENDING, mb->base + RECV_CLEAR);
+		readl(mb->base + RECV_CLEAR);	/* flush before GIC EOI */
+		return IRQ_NONE;
+	}
+
+	if (pend & MSG_SEND) {
+		for (i = 0; i < ARRAY_SIZE(rx.word); i++)
+			rx.word[i] = readl(mb->base + RECV_DATA(i));
+		spin_lock(&mb->rx_lock);
+		if (!kfifo_put(&mb->rx_fifo, rx))
+			mb->rx_dropped++;
+		spin_unlock(&mb->rx_lock);
+		writel(MSG_SEND, mb->base + RECV_CLEAR);
+		readl(mb->base + RECV_CLEAR);
+		ret = IRQ_WAKE_THREAD;
+	}
+
+	pend &= MSG_ALL_PENDING & ~MSG_SEND;
+	if (pend) {
+		dev_warn_ratelimited(mb->dev, "unexpected pending bits 0x%02x\n",
+				     pend);
+		writel(pend, mb->base + RECV_CLEAR);
+		readl(mb->base + RECV_CLEAR);
+		if (ret == IRQ_NONE)
+			ret = IRQ_HANDLED;
+	}
+
+	return ret;
+}
+
+static irqreturn_t sdp_msgbox_thread(int irq, void *data)
+{
+	struct sdp_msgbox *mb = data;
+	struct sdp_msgbox_rx rx;
+	sdp_msgbox_rx_cb_t cb;
+	unsigned long flags;
+	void *priv;
+	u32 len;
+
+	for (;;) {
+		spin_lock_irqsave(&mb->rx_lock, flags);
+		if (!kfifo_get(&mb->rx_fifo, &rx)) {
+			spin_unlock_irqrestore(&mb->rx_lock, flags);
+			break;
+		}
+		spin_unlock_irqrestore(&mb->rx_lock, flags);
+
+		len = rx.word[0];
+		if (!len || len > SDP_MSGBOX_MSG_MAX) {
+			dev_err_ratelimited(mb->dev, "invalid message size %u\n",
+					    len);
+			continue;
+		}
+
+		spin_lock_irqsave(&mb->cb_lock, flags);
+		cb = mb->rx_cb;
+		priv = mb->rx_priv;
+		spin_unlock_irqrestore(&mb->cb_lock, flags);
+		if (cb)
+			cb(priv, (const u8 *)&rx.word[1], len);
+	}
+
+	return IRQ_HANDLED;
+}
+
+/**
+ * sdp_msgbox_send - send one message to the Micom
+ * @mb: message box
+ * @buf: payload
+ * @len: payload length, 1..SDP_MSGBOX_MSG_MAX
+ *
+ * Waits until both directions are idle (as the Samsung driver does), then
+ * writes the payload, the length and raises the send pending bit.
+ * Returns 0 or a negative error code.
+ */
+int sdp_msgbox_send(struct sdp_msgbox *mb, const u8 *buf, size_t len)
+{
+	u32 word[7] = { 0 };
+	int i, tries = SEND_WAIT_MS;
+
+	if (!mb)
+		return -ENODEV;
+	if (!len || len > SDP_MSGBOX_MSG_MAX)
+		return -EINVAL;
+
+	memcpy(word, buf, len);	/* little-endian packing, as the original */
+
+	mutex_lock(&mb->send_lock);
+	while ((readl(mb->base + SEND_PEND) & MSG_SEND) ||
+	       (readl(mb->base + RECV_PEND) & MSG_SEND)) {
+		if (!tries--) {
+			mutex_unlock(&mb->send_lock);
+			dev_err(mb->dev, "send timeout\n");
+			return -ETIMEDOUT;
+		}
+		usleep_range(1000, 1500);
+	}
+
+	for (i = 0; i < DIV_ROUND_UP(len, 4); i++)
+		writel(word[i], mb->base + SEND_DATA(1 + i));
+	writel(len, mb->base + SEND_DATA(0));
+	writel(MSG_SEND, mb->base + SEND_PEND);
+	mutex_unlock(&mb->send_lock);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(sdp_msgbox_send);
+
+/**
+ * sdp_msgbox_set_rx_callback - install the receive callback (one consumer)
+ */
+int sdp_msgbox_set_rx_callback(struct sdp_msgbox *mb, sdp_msgbox_rx_cb_t cb,
+			       void *priv)
+{
+	unsigned long flags;
+	int ret = 0;
+
+	if (!mb)
+		return -ENODEV;
+
+	spin_lock_irqsave(&mb->cb_lock, flags);
+	if (cb && mb->rx_cb) {
+		ret = -EBUSY;
+	} else {
+		mb->rx_cb = cb;
+		mb->rx_priv = priv;
+	}
+	spin_unlock_irqrestore(&mb->cb_lock, flags);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(sdp_msgbox_set_rx_callback);
+
+/**
+ * sdp_msgbox_get - find the message box referenced by "samsung,messagebox"
+ * @dev: consumer device (gets a device link to the message box)
+ * @np: consumer node holding the phandle
+ *
+ * Returns the message box, ERR_PTR(-EPROBE_DEFER) if it is not bound yet.
+ */
+struct sdp_msgbox *sdp_msgbox_get(struct device *dev, struct device_node *np)
+{
+	struct platform_device *pdev;
+	struct device_node *mb_np;
+	struct sdp_msgbox *mb;
+
+	mb_np = of_parse_phandle(np, "samsung,messagebox", 0);
+	if (!mb_np)
+		return ERR_PTR(-ENODEV);
+
+	pdev = of_find_device_by_node(mb_np);
+	of_node_put(mb_np);
+	if (!pdev)
+		return ERR_PTR(-EPROBE_DEFER);
+
+	mb = platform_get_drvdata(pdev);
+	if (!mb) {
+		put_device(&pdev->dev);
+		return ERR_PTR(-EPROBE_DEFER);
+	}
+
+	if (!device_link_add(dev, &pdev->dev, DL_FLAG_AUTOREMOVE_CONSUMER)) {
+		put_device(&pdev->dev);
+		return ERR_PTR(-EINVAL);
+	}
+	put_device(&pdev->dev);
+
+	return mb;
+}
+EXPORT_SYMBOL_GPL(sdp_msgbox_get);
+
+static int sdp_msgbox_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct sdp_msgbox *mb;
+	int ret;
+
+	mb = devm_kzalloc(dev, sizeof(*mb), GFP_KERNEL);
+	if (!mb)
+		return -ENOMEM;
+
+	mb->dev = dev;
+	spin_lock_init(&mb->rx_lock);
+	spin_lock_init(&mb->cb_lock);
+	mutex_init(&mb->send_lock);
+	INIT_KFIFO(mb->rx_fifo);
+
+	mb->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(mb->base))
+		return PTR_ERR(mb->base);
+
+	mb->irq = platform_get_irq(pdev, 0);
+	if (mb->irq < 0)
+		return mb->irq;
+
+	if (readl(mb->base + RECV_PEND))
+		dev_warn(dev, "clearing stale pending bits 0x%08x\n",
+			 readl(mb->base + RECV_PEND));
+	writel(MSG_ALL_PENDING, mb->base + RECV_CLEAR);
+	readl(mb->base + RECV_CLEAR);
+
+	ret = devm_request_threaded_irq(dev, mb->irq, sdp_msgbox_isr,
+					sdp_msgbox_thread, 0, dev_name(dev), mb);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot request IRQ %d\n",
+				     mb->irq);
+
+	platform_set_drvdata(pdev, mb);
+	dev_info(dev, "Micom message box, irq %d\n", mb->irq);
+	return 0;
+}
+
+static const struct of_device_id sdp_msgbox_of_match[] = {
+	{ .compatible = "samsung,sdp-messagebox" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sdp_msgbox_of_match);
+
+static struct platform_driver sdp_msgbox_driver = {
+	.probe = sdp_msgbox_probe,
+	.driver = {
+		.name = "sdp-msgbox",
+		.of_match_table = sdp_msgbox_of_match,
+		.suppress_bind_attrs = true,
+	},
+};
+module_platform_driver(sdp_msgbox_driver);
+
+MODULE_DESCRIPTION("Samsung SDP Micom message box");
+MODULE_LICENSE("GPL");
