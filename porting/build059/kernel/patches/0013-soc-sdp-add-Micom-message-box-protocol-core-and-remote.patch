+ * Samsung SDP (Nike-L) remote control via the Micom.
+ *
+ * The Micom decodes the Samsung IR remote (and the front panel keys) itself
+ * and reports key press/release events with an 8-bit key code over the
+ * message box. This driver turns them into an rc-core scancode device with
+ * Samsung's key map.
+ *
+ * Linux 6.6 port of tztv-micom/rc-wt61p807.c and keymap-rc-wt61p807.c from
+ * Samsung's GPL package 20_DTV_NikeL (Copyright (C) 2013 Samsung
+ * Electronics Co. Ltd., GPL-2.0). The key map is Samsung's, minus six
+ * hotel-TV codes that do not exist in mainline (KEY_NR, KEY_HOTEL_*:
+ * scancodes 0x2a, 0x35, 0xa1, 0xa2, 0xa3, 0xa7). Android maps the
+ * resulting evdev codes with a key layout file (e.g. KEY_F10 = volume up,
+ * as on Tizen). Not ported: SBB socket bridge, rc_generate/rc_enable sysfs.
+ */
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/soc/sdp/sdp-micom.h>
+#include <media/rc-core.h>
+#include <media/rc-map.h>
+
+#define DRIVER_NAME		"sdp-micom-rc"
+#define RC_MAP_SDP_MICOM	"rc-sdp-micom"
