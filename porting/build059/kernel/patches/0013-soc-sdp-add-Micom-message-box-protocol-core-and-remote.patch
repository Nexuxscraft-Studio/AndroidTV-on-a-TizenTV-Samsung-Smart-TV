+
+static struct rc_map_list sdp_micom_map = {
+	.map = {
+		.scan = sdp_micom_keys,
+		.size = ARRAY_SIZE(sdp_micom_keys),
+		.rc_proto = RC_PROTO_OTHER,
+		.name = RC_MAP_SDP_MICOM,
+	},
+};
+
+static void sdp_micom_rc_event(const struct sdp_micom_msg *msg, void *priv)
+{
+	struct rc_dev *rc = priv;
+
+	switch (msg->data[0]) {
+	case SDP_MICOM_EVT_KEYPRESS:
+	case SDP_MICOM_EVT_KEY_UNDEFINED:
+		rc_keydown(rc, RC_PROTO_OTHER, msg->data[1], 0);
+		break;
+	case SDP_MICOM_EVT_KEYRELEASE:
+		rc_keyup(rc);
+		break;
+	}
+}
+
+static void sdp_micom_rc_detach(void *data)
+{
+	sdp_micom_unregister_client(data, SDP_MICOM_CLIENT_IR);
+}
+
+static int sdp_micom_rc_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct sdp_micom *micom;
+	struct rc_dev *rc;
+	int ret;
+
+	micom = sdp_micom_get(dev);
+	if (IS_ERR(micom))
+		return PTR_ERR(micom);
+
+	rc = devm_rc_allocate_device(dev, RC_DRIVER_SCANCODE);
+	if (!rc)
+		return -ENOMEM;
+
+	rc->device_name = "Samsung SDP Micom remote";
+	rc->input_phys = DRIVER_NAME "/input0";
+	rc->input_id.bustype = BUS_HOST;
+	rc->input_id.version = 1;
+	rc->driver_name = DRIVER_NAME;
+	rc->map_name = RC_MAP_SDP_MICOM;
+	rc->allowed_protocols = RC_PROTO_BIT_OTHER;
+	rc->enabled_protocols = RC_PROTO_BIT_OTHER;
+
+	ret = devm_rc_register_device(dev, rc);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot register rc device\n");
+
+	ret = sdp_micom_register_client(micom, SDP_MICOM_CLIENT_IR,
+					sdp_micom_rc_event, rc);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot attach to Micom\n");
+
+	return devm_add_action_or_reset(dev, sdp_micom_rc_detach, micom);
+}
+
+static struct platform_driver sdp_micom_rc_driver = {
+	.probe = sdp_micom_rc_probe,
+	.driver = {
+		.name = DRIVER_NAME,
+	},
+};
+
+static int __init sdp_micom_rc_init(void)
+{
+	int ret;
+
+	ret = rc_map_register(&sdp_micom_map);
+	if (ret)
+		return ret;
+
+	ret = platform_driver_register(&sdp_micom_rc_driver);
+	if (ret)
+		rc_map_unregister(&sdp_micom_map);
+	return ret;
+}
+module_init(sdp_micom_rc_init);
+
+static void __exit sdp_micom_rc_exit(void)
+{
+	platform_driver_unregister(&sdp_micom_rc_driver);
+	rc_map_unregister(&sdp_micom_map);
+}
+module_exit(sdp_micom_rc_exit);
+
+MODULE_ALIAS("platform:" DRIVER_NAME);
+MODULE_DESCRIPTION("Samsung SDP Micom remote control");
+MODULE_LICENSE("GPL");
