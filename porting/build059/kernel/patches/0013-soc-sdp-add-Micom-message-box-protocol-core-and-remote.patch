+		/*
+		 * Micom message box. reg/interrupts from the firmware DT
+		 * (T-NKLDEUC 2743.0 dtb.bin, nikel-2G, sha256 0189cc94..,
+		 * node /soc/msgbox: reg <0x9c0400 0x100>, interrupts
+		 * <0 0x22 0>, trigger type left unspecified as there).
+		 */
+		msgbox: mailbox@9c0400 {
+			compatible = "samsung,sdp-messagebox";
+			reg = <0x009c0400 0x100>;
+			interrupts = <GIC_SPI 34 IRQ_TYPE_NONE>;
+			status = "disabled";
+		};
+	};
+
+	/*
+	 * Micom protocol (firmware node /tztv_micom, compatible
+	 * "samsung,tztv-micom", no registers of its own). The phandle to the
+	 * message box replaces the global variables of the Samsung driver.
+	 */
+	micom {
+		compatible = "samsung,tztv-micom";
+		samsung,messagebox = <&msgbox>;
+		status = "disabled";
 	};
 };
