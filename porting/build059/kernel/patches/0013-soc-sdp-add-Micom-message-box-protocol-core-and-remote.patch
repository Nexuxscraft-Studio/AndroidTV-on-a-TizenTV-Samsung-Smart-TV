+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Samsung SDP (Nike-L) Micom message box and Micom protocol interface.
+ *
+ * Linux 6.6 port of Samsung's GPL sources from the 20_DTV_NikeL package:
+ * linux-4.1.10/drivers/mailbox/sdp_micom_msgbox.c and
+ * tztv-micom/sdp_micom.h, sdp_micom_messagebox.c
+ * (Copyright (C) 2013-2020 Samsung Electronics Co. Ltd., GPL-2.0).
+ */
+#ifndef __LINUX_SOC_SDP_MICOM_H
+#define __LINUX_SOC_SDP_MICOM_H
+
+#include <linux/types.h>
+
+struct device;
+struct device_node;
+struct sdp_msgbox;
+struct sdp_micom;
+
+/* ---- message box (hardware mailbox between CPU and Micom) ---- */
+
+/* largest message in one message box transfer (7 data words) */
+#define SDP_MSGBOX_MSG_MAX	28
+
+typedef void (*sdp_msgbox_rx_cb_t)(void *priv, const u8 *buf, size_t len);
+
+struct sdp_msgbox *sdp_msgbox_get(struct device *dev, struct device_node *np);
+int sdp_msgbox_set_rx_callback(struct sdp_msgbox *mb, sdp_msgbox_rx_cb_t cb,
+			       void *priv);
+int sdp_msgbox_send(struct sdp_msgbox *mb, const u8 *buf, size_t len);
+
+/* ---- Micom protocol ---- */
+
+/* commands to the Micom */
+#define SDP_MICOM_CMD_POWEROFF		0x12
+#define SDP_MICOM_CMD_VERSION		0x20
+
+/* events from the Micom */
+#define SDP_MICOM_EVT_KEYPRESS		0x10
+#define SDP_MICOM_EVT_PANEL_KEYPRESS	0x11
+#define SDP_MICOM_EVT_KEYRELEASE	0x1E
+#define SDP_MICOM_EVT_KEY_UNDEFINED	0xAA
+
+/* acks from the Micom */
+#define SDP_MICOM_ACK_VERSION		0x30
+#define SDP_MICOM_ACK_UNKNOWN		0xE4
+
+/* key code reported for SDP_MICOM_EVT_KEY_UNDEFINED */
+#define SDP_MICOM_KEY_UNDEFINED		0xF5
+
+enum sdp_micom_client {
+	SDP_MICOM_CLIENT_IR,
+	SDP_MICOM_CLIENT_PANEL,
+	SDP_MICOM_CLIENT_CEC,
+	SDP_MICOM_CLIENT_MSG,
+	SDP_MICOM_CLIENT_NUM,
+};
+
+enum sdp_micom_msg_type {
+	SDP_MICOM_MSG_NORMAL,
+	SDP_MICOM_MSG_CEC,
+	SDP_MICOM_MSG_EXTENDED,
+};
+
+#define SDP_MICOM_MSG_MAX	32
+
+struct sdp_micom_msg {
+	enum sdp_micom_msg_type type;
+	unsigned int len;
+	u8 data[SDP_MICOM_MSG_MAX];
+};
+
+typedef void (*sdp_micom_cb_t)(const struct sdp_micom_msg *msg, void *priv);
+
+struct sdp_micom *sdp_micom_get(struct device *child);
+int sdp_micom_register_client(struct sdp_micom *micom,
+			      enum sdp_micom_client id, sdp_micom_cb_t cb,
+			      void *priv);
+void sdp_micom_unregister_client(struct sdp_micom *micom,
+				 enum sdp_micom_client id);
+int sdp_micom_send_cmd(struct sdp_micom *micom, u8 cmd, const u8 *data,
+		       size_t len);
+int sdp_micom_send_cmd_ack(struct sdp_micom *micom, u8 cmd, u8 ack,
+			   const u8 *data, size_t len, u8 *ack_data,
+			   unsigned int timeout_ms);
+
+#endif /* __LINUX_SOC_SDP_MICOM_H */
