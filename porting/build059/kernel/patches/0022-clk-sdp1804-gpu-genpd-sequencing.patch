diff --git a/drivers/clk/clk-sdp1804-gpu.c b/drivers/clk/clk-sdp1804-gpu.c
new file mode 100644
index 000000000..0c7b1a23f
--- /dev/null
+++ b/drivers/clk/clk-sdp1804-gpu.c
@@ -0,0 +1,129 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Nike-L GPU power sequencing, Build 070 Design 2 (genpd).
+ * Register layout: Samsung mali_kbase_config_platform.h, NIKEL branch,
+ * lines 101-106, 128-140, 150-162. Ordering: mali_kbase_platform_sdp.c
+ * lines 470-494, tztv-media-nike/sdp_gpu_nike/.../platform/sdp/.
+ * Shares the existing SDP1804 mapping; this is the only GPU gate/reset
+ * writer. CCF must NOT also gate the GPU or export these resets.
+ * Both the domain child and the GPU are disabled in the shipped DT.
+ */
+#include <linux/bitops.h>
+#include <linux/errno.h>
+#include <linux/iopoll.h>
+#include <linux/pm_domain.h>
+#include <linux/slab.h>
+
+#include "clk-sdp1804-gpu.h"
+
+#define GPU_RESET	0x07f8
+#define GPU_GATE	0x088c
+#define GPU_IDLE_REQ	0x0a10
+#define GPU_IDLE_ACK	0x0a14
+#define GPU_BUS_NRESET	BIT(24)
+#define GPU_CORE_NRESET	BIT(28)
+#define GPU_GATE_ON	BIT(12)
+#define GPU_IDLE	BIT(0)
+/* Software safety bound, not a measured hardware timing requirement. */
+#define GPU_IDLE_TIMEOUT_US	2000
+
+struct sdp1804_gpu_power {
+	struct generic_pm_domain domain;
+	void __iomem *base;
+};
+
+static void gpu_update(struct sdp1804_gpu_power *gpu, u32 offset,
+		       u32 mask, bool set)
+{
+	u32 value = readl(gpu->base + offset);
+
+	value = set ? value | mask : value & ~mask;
+	writel(value, gpu->base + offset);
+	/* Drain posted writes before the next sequencing step. */
+	readl(gpu->base + offset);
+}
+
+static int sdp1804_gpu_on(struct generic_pm_domain *domain)
+{
+	struct sdp1804_gpu_power *gpu = container_of(domain,
+					struct sdp1804_gpu_power, domain);
+
+	gpu_update(gpu, GPU_GATE, GPU_GATE_ON, true);
+	gpu_update(gpu, GPU_RESET, GPU_BUS_NRESET, true);
+	gpu_update(gpu, GPU_RESET, GPU_CORE_NRESET, true);
+	gpu_update(gpu, GPU_IDLE_REQ, GPU_IDLE, false);
+	return 0;
+}
+
+static int sdp1804_gpu_off(struct generic_pm_domain *domain)
+{
+	struct sdp1804_gpu_power *gpu = container_of(domain,
+					struct sdp1804_gpu_power, domain);
+	bool was_requested = readl(gpu->base + GPU_IDLE_REQ) & GPU_IDLE;
+	u32 value;
+	int ret;
+
+	gpu_update(gpu, GPU_IDLE_REQ, GPU_IDLE, true);
+	/* Samsung waits for a nonzero full register value, not a proven bit. */
+	ret = readl_poll_timeout(gpu->base + GPU_IDLE_ACK, value,
+				value != 0, 1, GPU_IDLE_TIMEOUT_US);
+	if (ret) {
+		/* Keep clock and resets intact; genpd retains the ON state. */
+		gpu_update(gpu, GPU_IDLE_REQ, GPU_IDLE, was_requested);
+		return ret;
+	}
+	gpu_update(gpu, GPU_RESET, GPU_BUS_NRESET, false);
+	gpu_update(gpu, GPU_RESET, GPU_CORE_NRESET, false);
+	gpu_update(gpu, GPU_GATE, GPU_GATE_ON, false);
+	return 0;
+}
+
+int sdp1804_gpu_power_init(struct device_node *np, void __iomem *base)
+{
+	struct sdp1804_gpu_power *gpu;
+	struct device_node *child;
+	u32 gate, reset;
+	bool is_off;
+	int ret;
+
+	child = of_get_child_by_name(np, "gpu-power-domain");
+	if (!child)
+		return 0;
+	if (!of_device_is_available(child)) {
+		ret = 0;
+		goto put_node;
+	}
+	/* Read state only after explicit domain enablement; never force a reset. */
+	gate = readl(base + GPU_GATE) & GPU_GATE_ON;
+	reset = readl(base + GPU_RESET) & (GPU_BUS_NRESET | GPU_CORE_NRESET);
+	if (!gate && !reset)
+		is_off = true;
+	else if (gate && reset == (GPU_BUS_NRESET | GPU_CORE_NRESET) &&
+		 !(readl(base + GPU_IDLE_REQ) & GPU_IDLE))
+		is_off = false;
+	else {
+		ret = -EINVAL; /* mixed boot state: do not guess */
+		goto put_node;
+	}
+	gpu = kzalloc(sizeof(*gpu), GFP_KERNEL);
+	if (!gpu) {
+		ret = -ENOMEM;
+		goto put_node;
+	}
+	gpu->base = base;
+	gpu->domain.name = "sdp1804-gpu";
+	gpu->domain.power_on = sdp1804_gpu_on;
+	gpu->domain.power_off = sdp1804_gpu_off;
+	ret = pm_genpd_init(&gpu->domain, NULL, is_off);
+	if (ret)
+		goto free_gpu;
+	ret = of_genpd_add_provider_simple(child, &gpu->domain);
+	if (!ret)
+		goto put_node; /* lifetime matches the early clock provider */
+	pm_genpd_remove(&gpu->domain);
+free_gpu:
+	kfree(gpu);
+put_node:
+	of_node_put(child);
+	return ret;
+}
