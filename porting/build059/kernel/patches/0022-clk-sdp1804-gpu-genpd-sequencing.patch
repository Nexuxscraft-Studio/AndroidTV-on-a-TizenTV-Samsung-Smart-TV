+++ b/drivers/clk/clk-sdp1804-gpu.h
@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef CLK_SDP1804_GPU_H
+#define CLK_SDP1804_GPU_H
+
+#include <linux/io.h>
+#include <linux/kconfig.h>
+#include <linux/of.h>
+
+#if IS_ENABLED(CONFIG_SDP1804_GPU_POWER)
+int sdp1804_gpu_power_init(struct device_node *np, void __iomem *base);
+#else
+static inline int sdp1804_gpu_power_init(struct device_node *np,
+				       void __iomem *base)
+{
+	return 0;
+}
+#endif
+#endif
