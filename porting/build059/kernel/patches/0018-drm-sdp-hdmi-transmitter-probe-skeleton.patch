diff --git a/drivers/gpu/drm/sdp-hdmi/sdp_hdmi.c b/drivers/gpu/drm/sdp-hdmi/sdp_hdmi.c
new file mode 100644
index 000000000..b3e9c3cf5
--- /dev/null
+++ b/drivers/gpu/drm/sdp-hdmi/sdp_hdmi.c
@@ -0,0 +1,140 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung SDP HDMI transmitter – probe-only skeleton
+ *
+ * Target SoC  : SDP1412 "Nike-L" (Samsung Q60T / Tizen 5.5)
+ * DT-compat   : "samsung,sdp-hdmi"
+ * GPL source  : none found in GPL inventory
+ *               (samsung,sdp-hdmi: no .c file)
+ *
+ * Hardware addresses from firmware dtb0
+ * (T-NKLDEUC 2743.0 dtb.bin, nikel-2G, sha256 0189cc94,
+ * node /soc/hdmi@00590000):
+ *
+ *   reg "hdmi-reg"           0x00590000  0x20000  main HDMI core
+ *   reg "hdmi-edid-reg"      0x00970000  0x5a0    E-EDID FIFO
+ *   reg "hdmi-common-reg"    0x005c0000  0xffff   common registers
+ *   reg "hdmi-esm-reg"       0x005b0000  0x8000   HDCP/ESM engine
+ *   reg "hdmi-dsc-musem-reg" 0x005b8000  0x300    DSC muse-M
+ *   reg "hdmi-dsc-museo-reg" 0x20898000  0x300    DSC muse-O
+ *   reg "hdmi-fec-museo-reg" 0x20898800  0x300    FEC muse-O
+ *
+ *   IRQ[0]  GIC SPI 88  (0x58) firmware <0x0 0x58 0x0>
+ *   IRQ[1]  GIC SPI 89  (0x59)
+ *   IRQ[2]  GIC SPI 90  (0x5a)
+ *   IRQ[3]  GIC SPI 104 (0x68)
+ *   IRQ[4]  GIC SPI 105 (0x69)
+ *   IRQ[5]  GIC SPI 106 (0x6a)
+ *   IRQ[6]  GIC SPI 109 (0x6d)
+ *   IRQ[7]  GIC SPI 93  (0x5d)
+ *
+ *   clocks: hdmi_pclk, hdmi_sysclk, hdmi_modclk
+ *   (clock indices TBD: no GPL source to confirm register values)
+ *
+ * Project rule: keine erfundenen Hardware-/ABI-Werte.
+ * Register layout and HDMI programming sequence unknown without GPL
+ * source.  This skeleton maps regions and requests IRQs (disabled)
+ * so the DT node is claimed and the driver probes cleanly.
+ *
+ * TODO:
+ *   1. Obtain GPL or upstream HDMI driver source for SDP1412.
+ *   2. Add hdmi_pclk / hdmi_sysclk / hdmi_modclk clock IDs to
+ *      include/dt-bindings/clock/samsung,sdp1804-clk.h.
+ *   3. Implement DRM bridge / connector for HDMI output.
+ *   4. Add HDCP support (ESM region).
+ *   5. Enable hdmi node in sdp-nikel-q60t-2g.dts.
+ */
+
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+/* Number of MMIO regions listed in the DT node (matches reg-names). */
+#define SDP_HDMI_NUM_REGIONS	7
+/* Number of IRQs listed in the DT node. */
+#define SDP_HDMI_NUM_IRQS	8
+
+/**
+ * struct sdp_hdmi_priv - driver private data
+ * @base:  mapped MMIO regions [0..SDP_HDMI_NUM_REGIONS-1]
+ */
+struct sdp_hdmi_priv {
+	void __iomem	*base[SDP_HDMI_NUM_REGIONS];
+};
+
+static irqreturn_t sdp_hdmi_irq(int irq, void *dev_id)
+{
+	/*
+	 * TODO: read HDMI interrupt status register, dispatch to
+	 * HPD / HDCP / link handlers once register layout is known.
+	 */
+	return IRQ_HANDLED;
+}
+
+static int sdp_hdmi_probe(struct platform_device *pdev)
+{
+	struct sdp_hdmi_priv *priv;
+	int i, irq, ret;
+
+	priv = devm_kzalloc(&pdev->dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	for (i = 0; i < SDP_HDMI_NUM_REGIONS; i++) {
+		priv->base[i] = devm_platform_ioremap_resource(pdev, i);
+		if (IS_ERR(priv->base[i]))
+			return dev_err_probe(&pdev->dev, PTR_ERR(priv->base[i]),
+					     "failed to map MMIO region %d\n", i);
+	}
+
+	for (i = 0; i < SDP_HDMI_NUM_IRQS; i++) {
+		irq = platform_get_irq(pdev, i);
+		if (irq < 0)
+			return dev_err_probe(&pdev->dev, irq,
+					     "failed to get IRQ %d\n", i);
+		/*
+		 * Request but leave disabled: IRQ handler is a stub until
+		 * the register layout is known.  IRQF_NO_AUTOEN keeps the
+		 * interrupt masked at the GIC so the stub never fires.
+		 */
+		ret = devm_request_irq(&pdev->dev, irq, sdp_hdmi_irq,
+				       IRQF_NO_AUTOEN, dev_name(&pdev->dev),
+				       priv);
+		if (ret)
+			return dev_err_probe(&pdev->dev, ret,
+					     "failed to request IRQ %d\n", i);
+	}
+
+	platform_set_drvdata(pdev, priv);
+
+	dev_info(&pdev->dev,
+		 "sdp_hdmi: probe OK (skeleton, HDMI not yet implemented)\n");
+	return 0;
+}
+
+static void sdp_hdmi_remove(struct platform_device *pdev)
+{
+	/* TODO: DRM bridge teardown */
+}
+
+static const struct of_device_id sdp_hdmi_of_match[] = {
+	{ .compatible = "samsung,sdp-hdmi" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, sdp_hdmi_of_match);
+
+static struct platform_driver sdp_hdmi_driver = {
+	.probe	= sdp_hdmi_probe,
+	.remove	= sdp_hdmi_remove,
+	.driver	= {
+		.name		= "sdp-hdmi",
+		.of_match_table	= sdp_hdmi_of_match,
+	},
+};
+module_platform_driver(sdp_hdmi_driver);
+
+MODULE_AUTHOR("Claude Sonnet 4.6 (skeleton)");
+MODULE_DESCRIPTION("Samsung SDP HDMI transmitter probe skeleton (Nike-L / SDP1412)");
+MODULE_LICENSE("GPL");
