+# SPDX-License-Identifier: GPL-2.0
+
+config DRM_SDP_HDMI
+	tristate "Samsung SDP Nike-L HDMI transmitter (probe skeleton)"
+	depends on DRM && OF && HAS_IOMEM
+	help
+	  Probe-only skeleton for the Samsung SDP1412 (Nike-L) HDMI
+	  transmitter.  Maps the seven MMIO regions declared in the DT
+	  node and requests the eight IRQs.  Full HDMI/HDCP/EDID
+	  implementation requires GPL source that is not yet available.
+
+	  Device-tree compatible: "samsung,sdp-hdmi".
+
+	  If unsure, say N.
