diff --git a/arch/arm64/boot/dts/samsung-sdp/sdp-nikel.dtsi b/arch/arm64/boot/dts/samsung-sdp/sdp-nikel.dtsi
index 82dc0e5ca..15207a7d2 100644
--- a/arch/arm64/boot/dts/samsung-sdp/sdp-nikel.dtsi
+++ b/arch/arm64/boot/dts/samsung-sdp/sdp-nikel.dtsi
@@ -365,6 +365,64 @@ drm@5d0000 {
 		 * phy_sel_reg   = <0x140000 0x1 0x1>.
 		 * bus-width, phy-mask, napi-weight: direct from firmware.
 		 */
+		/*
+		 * HDMI transmitter.  All values from firmware dtb0
+		 * (T-NKLDEUC 2743.0 dtb.bin, nikel-2G, sha256 0189cc94,
+		 * node /soc/hdmi@00590000).
+		 *
+		 * reg-names from firmware:
+		 *   "hdmi-reg"           0x590000 0x20000  main HDMI core
+		 *   "hdmi-edid-reg"      0x970000 0x5a0    E-EDID FIFO
+		 *   "hdmi-common-reg"    0x5c0000 0xffff   common regs
+		 *   "hdmi-esm-reg"       0x5b0000 0x8000   HDCP/ESM
+		 *   "hdmi-dsc-musem-reg" 0x5b8000 0x300    DSC muse-M
+		 *   "hdmi-dsc-museo-reg" 0x20898000 0x300  DSC muse-O
+		 *   "hdmi-fec-museo-reg" 0x20898800 0x300  FEC muse-O
+		 *
+		 * interrupts: 8 IRQs from firmware (no interrupt-names in
+		 * the firmware DT; order preserved exactly):
+		 *   <0x0 0x58 0x0> = GIC SPI 88
+		 *   <0x0 0x59 0x0> = GIC SPI 89
+		 *   <0x0 0x5a 0x0> = GIC SPI 90
+		 *   <0x0 0x68 0x0> = GIC SPI 104
+		 *   <0x0 0x69 0x0> = GIC SPI 105
+		 *   <0x0 0x6a 0x0> = GIC SPI 106
+		 *   <0x0 0x6d 0x0> = GIC SPI 109
+		 *   <0x0 0x5d 0x0> = GIC SPI 93
+		 *
+		 * clocks: 3 children of clock-controller@00F50000:
+		 *   hdmi_pclk, hdmi_sysclk, hdmi_modclk.
+		 *   Clock indices TBD from GPL source.
+		 *
+		 * No GPL driver source found (samsung,sdp-hdmi: no .c file
+		 * in GPL inventory).  Probe skeleton only.
+		 */
+		hdmi@590000 {
+			compatible = "samsung,sdp-hdmi";
+			reg = <0x00590000 0x20000>,	/* hdmi-reg         */
+			      <0x00970000 0x5a0>,	/* hdmi-edid-reg    */
+			      <0x005c0000 0xffff>,	/* hdmi-common-reg  */
+			      <0x005b0000 0x8000>,	/* hdmi-esm-reg     */
+			      <0x005b8000 0x300>,	/* hdmi-dsc-musem   */
+			      <0x20898000 0x300>,	/* hdmi-dsc-museo   */
+			      <0x20898800 0x300>;	/* hdmi-fec-museo   */
+			reg-names = "hdmi-reg", "hdmi-edid-reg",
+				    "hdmi-common-reg", "hdmi-esm-reg",
+				    "hdmi-dsc-musem-reg",
+				    "hdmi-dsc-museo-reg",
+				    "hdmi-fec-museo-reg";
+			interrupts = <GIC_SPI 88 IRQ_TYPE_NONE>,
+				     <GIC_SPI 89 IRQ_TYPE_NONE>,
+				     <GIC_SPI 90 IRQ_TYPE_NONE>,
+				     <GIC_SPI 104 IRQ_TYPE_NONE>,
+				     <GIC_SPI 105 IRQ_TYPE_NONE>,
+				     <GIC_SPI 106 IRQ_TYPE_NONE>,
+				     <GIC_SPI 109 IRQ_TYPE_NONE>,
+				     <GIC_SPI 93 IRQ_TYPE_NONE>;
+			/* clocks: TBD (hdmi_pclk, hdmi_sysclk, hdmi_modclk) */
+			status = "disabled";
+		};
+
 		emac: ethernet@120000 {
 			compatible = "samsung,sdp-mac";
 			reg = <0x00120000 0x100>,	/* MAC core */
