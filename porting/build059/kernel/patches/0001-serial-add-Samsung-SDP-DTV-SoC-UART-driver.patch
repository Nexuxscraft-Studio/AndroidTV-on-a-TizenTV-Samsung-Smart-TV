From ff2b6ed37f8674fc0a14a8ef6a3bf84ba23af27d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 10 Nov 2026 21:31:37 +0100
Subject: [PATCH 1/5] serial: add Samsung SDP DTV SoC UART driver

Add a driver for the "samsung,sdp-uart2" UART of Samsung SDP digital TV
SoCs (e.g. Nike-L in 2020 Q60T televisions), including console and
earlycon support.

Register layout and interrupt handling follow Samsung's GPL driver
drivers/tty/serial/sdp_uart2.c from linux-4.1.10-tizen5.5 (release
20_DTV_NikeL); the code is a rewrite for the Linux 6.6 serial core.

Without an input clock the driver reconstructs it from the divisor the
boot loader programmed, so a console works before a clock driver exists.
---
 .../bindings/serial/samsung,sdp-uart2.yaml    |  70 ++
 drivers/tty/serial/Kconfig                    |  19 +
 drivers/tty/serial/Makefile                   |   1 +
 drivers/tty/serial/sdp_uart.c                 | 806 ++++++++++++++++++
 4 files changed, 896 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/serial/samsung,sdp-uart2.yaml
 create mode 100644 drivers/tty/serial/sdp_uart.c

diff --git a/Documentation/devicetree/bindings/serial/samsung,sdp-uart2.yaml b/Documentation/devicetree/bindings/serial/samsung,sdp-uart2.yaml
new file mode 100644
index 000000000..3244bd2a8
--- /dev/null
+++ b/Documentation/devicetree/bindings/serial/samsung,sdp-uart2.yaml
@@ -0,0 +1,70 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/serial/samsung,sdp-uart2.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung SDP digital TV SoC UART
+
+maintainers:
+  - Nexuxscraft-Studio Samsung-ATV-Lab
+
+description:
+  UART of Samsung SDP digital TV SoCs (for example Nike-L / SDP1804). The
+  register set follows the Samsung S3C UART family, but every port has
+  separate TX and RX interrupt lines and latched, write-one-to-clear
+  interrupt status bits in UTRSTAT.
+
+allOf:
+  - $ref: serial.yaml#
+
+properties:
+  compatible:
+    const: samsung,sdp-uart2
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    items:
+      - description: transmit interrupt
+      - description: receive interrupt
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    const: apb_pclk
+
+  clock-frequency:
+    description: UART input clock rate, used when no clock is given
+
+  enhanced:
+    type: boolean
+    description: The port has the 64 byte "enhanced" FIFO
+
+  samsung,boot-baudrate:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    default: 115200
+    description:
+      Baud rate the boot loader configured. Used to derive the input clock
+      from the divisor register when neither clocks nor clock-frequency
+      are given.
+
+required:
+  - compatible
+  - reg
+  - interrupts
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    serial@190a00 {
+        compatible = "samsung,sdp-uart2";
+        reg = <0x00190a00 0x40>;
+        interrupts = <GIC_SPI 72 IRQ_TYPE_LEVEL_HIGH>,
+                     <GIC_SPI 73 IRQ_TYPE_LEVEL_HIGH>;
+        enhanced;
+    };
