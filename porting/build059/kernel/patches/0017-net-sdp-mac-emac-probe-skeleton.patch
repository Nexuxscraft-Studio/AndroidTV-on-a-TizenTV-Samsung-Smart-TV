diff --git a/drivers/net/ethernet/sdp/Kconfig b/drivers/net/ethernet/sdp/Kconfig
new file mode 100644
index 000000000..567e8f144
--- /dev/null
+++ b/drivers/net/ethernet/sdp/Kconfig
@@ -0,0 +1,28 @@
+# SPDX-License-Identifier: GPL-2.0
+# Samsung SDP (Smart Display Platform) Ethernet driver
+
+config NET_VENDOR_SDP
+	bool "Samsung SDP Ethernet devices"
+	default y if ARCH_SAMSUNG_SDP
+	help
+	  Enable support for Samsung SDP (Smart Display Platform) on-chip
+	  Ethernet controllers.
+
+	  If unsure, say N.
+
+if NET_VENDOR_SDP
+
+config SDP_MAC
+	tristate "Samsung SDP EMAC (sdp_mac) driver"
+	depends on OF && HAS_IOMEM
+	select PHYLIB
+	help
+	  Probe-only skeleton for the Samsung SDP1412 (Nike-L) EMAC
+	  controller.  Hardware register layout and MAC programming will be
+	  filled in after GPL source (sdp_mac.c) is imported.
+
+	  Device-tree compatible: "samsung,sdp-mac".
+
+	  If unsure, say N.
+
+endif # NET_VENDOR_SDP
