diff --git a/arch/arm64/boot/dts/samsung-sdp/sdp-nikel.dtsi b/arch/arm64/boot/dts/samsung-sdp/sdp-nikel.dtsi
index fc472833b..82dc0e5ca 100644
--- a/arch/arm64/boot/dts/samsung-sdp/sdp-nikel.dtsi
+++ b/arch/arm64/boot/dts/samsung-sdp/sdp-nikel.dtsi
@@ -339,6 +339,49 @@ drm@5d0000 {
 				     <GIC_SPI 102 IRQ_TYPE_NONE>;
 			status = "disabled";
 		};
+
+		/*
+		 * Ethernet MAC.  All values from firmware dtb0
+		 * (T-NKLDEUC 2743.0 dtb.bin, nikel-2G, sha256 0189cc94,
+		 * node /soc/emac).
+		 *
+		 * reg: five consecutive blocks (firmware gives them as
+		 * 10 u32 pairs):
+		 *   0x120000 0x100  – MAC core registers
+		 *   0x120100 0x300  – MAC registers block 1
+		 *   0x120700 0x100  – MAC registers block 2
+		 *   0x120800 0x100  – MAC registers block 3
+		 *   0x121000 0x100  – MAC registers block 4
+		 *
+		 * interrupts: GIC SPI 7 (firmware <0x0 0x7 0x0>).
+		 *
+		 * clock-names: "emac_clk" (firmware clock-names property).
+		 * clocks phandle index TBD: not derivable without sdp_mac.c
+		 * GPL source (project rule: keine erfundenen Hardware-Werte).
+		 * Will be filled after MODE=show run reads sdp_mac.c.
+		 *
+		 * samsung,pad-ctrl-reg / samsung,phy-sel-reg: firmware
+		 * pad_ctrl_reg = <0x130000 0x1 0x1>,
+		 * phy_sel_reg   = <0x140000 0x1 0x1>.
+		 * bus-width, phy-mask, napi-weight: direct from firmware.
+		 */
+		emac: ethernet@120000 {
+			compatible = "samsung,sdp-mac";
+			reg = <0x00120000 0x100>,	/* MAC core */
+			      <0x00120100 0x300>,	/* block 1  */
+			      <0x00120700 0x100>,	/* block 2  */
+			      <0x00120800 0x100>,	/* block 3  */
+			      <0x00121000 0x100>;	/* block 4  */
+			interrupts = <GIC_SPI 7 IRQ_TYPE_NONE>;
+			/* clocks: TBD after sdp_mac.c MODE=show */
+			clock-names = "emac_clk";
+			samsung,pad-ctrl-reg = <0x130000 0x1 0x1>;
+			samsung,phy-sel-reg = <0x140000 0x1 0x1>;
+			samsung,bus-width = <64>;
+			phy-mask = <0x0>;
+			napi-weight = <64>;
+			status = "disabled";
+		};
 	};
 
