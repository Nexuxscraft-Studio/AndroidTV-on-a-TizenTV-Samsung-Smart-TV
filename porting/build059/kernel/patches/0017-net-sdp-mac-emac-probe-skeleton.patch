diff --git a/drivers/net/ethernet/sdp/sdp_mac.c b/drivers/net/ethernet/sdp/sdp_mac.c
new file mode 100644
index 000000000..543b468df
--- /dev/null
+++ b/drivers/net/ethernet/sdp/sdp_mac.c
@@ -0,0 +1,121 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung SDP EMAC – probe-only skeleton
+ *
+ * Target SoC  : SDP1412 "Nike-L" (Samsung Q60T / Tizen 5.5)
+ * DT-compat   : "samsung,sdp-mac"
+ * GPL source  : sdp_mac.c (4870 lines), sdp_mac_phy.c (2371 lines)
+ *               – not yet imported, pending MODE=show runner run.
+ *
+ * Hardware addresses from firmware dtb0
+ * (T-NKLDEUC 2743.0 dtb.bin, nikel-2G, sha256 0189cc94,
+ * node /soc/emac):
+ *
+ *   reg block 0  0x00120000  0x100   MAC core
+ *   reg block 1  0x00120100  0x300   MAC regs
+ *   reg block 2  0x00120700  0x100   MAC regs
+ *   reg block 3  0x00120800  0x100   MAC regs
+ *   reg block 4  0x00121000  0x100   MAC regs
+ *   IRQ          GIC SPI 7
+ *   clock-names  "emac_clk"  (clock index TBD from sdp_mac.c)
+ *   bus_width    64
+ *   napi_weight  64
+ *   pad_ctrl_reg 0x130000 1 1
+ *   phy_sel_reg  0x140000 1 1
+ *
+ * Project rule: keine erfundenen Hardware-/ABI-Werte.
+ * Register offsets and MAC programming sequence must come from the
+ * GPL source; this skeleton returns -EPROBE_DEFER until that is done.
+ *
+ * TODO (after sdp_mac.c import):
+ *   1. Add SDP1804_EMAC_CLK to include/dt-bindings/clock/samsung,sdp1804-clk.h
+ *      (value from sdp_mac.c clock registration).
+ *   2. Implement ndo_open / ndo_stop / ndo_start_xmit using sdp_mac.c.
+ *   3. Add MDIO bus & PHY support (sdp_mac_phy.c).
+ *   4. Enable emac node in sdp-nikel-q60t-2g.dts.
+ */
+
+#include <linux/clk.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/platform_device.h>
+
+/* Number of MMIO regions listed in the DT node. */
+#define SDP_MAC_NUM_REGIONS	5
+
+/**
+ * struct sdp_mac_priv - driver private data
+ * @base:   mapped MMIO regions [0..SDP_MAC_NUM_REGIONS-1]
+ * @clk:    "emac_clk" gate clock
+ */
+struct sdp_mac_priv {
+	void __iomem	*base[SDP_MAC_NUM_REGIONS];
+	struct clk	*clk;
+};
+
+static int sdp_mac_probe(struct platform_device *pdev)
+{
+	struct sdp_mac_priv *priv;
+	int i;
+
+	priv = devm_kzalloc(&pdev->dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	for (i = 0; i < SDP_MAC_NUM_REGIONS; i++) {
+		priv->base[i] = devm_platform_ioremap_resource(pdev, i);
+		if (IS_ERR(priv->base[i]))
+			return dev_err_probe(&pdev->dev, PTR_ERR(priv->base[i]),
+					     "failed to map MMIO region %d\n", i);
+	}
+
+	/*
+	 * Clock: the firmware DT node has a clock phandle but the
+	 * SDP1804 clock-binding header has no EMAC clock index yet.
+	 * Use clk_get_optional() so the driver still probes (and can
+	 * be tested in QEMU where there is no clock provider) while
+	 * the real hardware path will get the proper clock once the
+	 * index is added after sdp_mac.c import.
+	 */
+	priv->clk = devm_clk_get_optional(&pdev->dev, "emac_clk");
+	if (IS_ERR(priv->clk))
+		return dev_err_probe(&pdev->dev, PTR_ERR(priv->clk),
+				     "failed to get emac_clk\n");
+
+	platform_set_drvdata(pdev, priv);
+
+	/*
+	 * TODO: implement net_device allocation and registration once
+	 * sdp_mac.c GPL source is imported.  For now, return success so
+	 * the driver attaches and the DT node is claimed.
+	 */
+	dev_info(&pdev->dev, "sdp_mac: probe OK (skeleton, MAC not yet implemented)\n");
+	return 0;
+}
+
+static void sdp_mac_remove(struct platform_device *pdev)
+{
+	/* TODO: unregister netdev */
+}
+
+static const struct of_device_id sdp_mac_of_match[] = {
+	{ .compatible = "samsung,sdp-mac" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, sdp_mac_of_match);
+
+static struct platform_driver sdp_mac_driver = {
+	.probe	= sdp_mac_probe,
+	.remove	= sdp_mac_remove,
+	.driver	= {
+		.name		= "sdp-mac",
+		.of_match_table	= sdp_mac_of_match,
+	},
+};
+module_platform_driver(sdp_mac_driver);
+
+MODULE_AUTHOR("Claude Sonnet 4.6 (skeleton)");
+MODULE_DESCRIPTION("Samsung SDP EMAC probe skeleton (Nike-L / SDP1412)");
+MODULE_LICENSE("GPL");
