From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude Sonnet 4.6 <noreply@anthropic.com>
Date: Thu, 12 Nov 2026 00:00:00 +0000
Subject: [PATCH 0022] misc: sdp-micom: IRS full GPL port (cdev)

Full port of drivers/misc/sdp-micom/sdp_micom_irs.c from Samsung GPL
source sdp_micom_irs.c (v0.5 20200309, 372 lines).  Replaces the probe
skeleton introduced in patch 0019.

API migrations from kernel 4.1 to 6.6:
- #include <asm/uaccess.h>  -> #include <linux/uaccess.h>
- class_create(THIS_MODULE, name) -> class_create(name)  (since 6.4)
- devnode callback: char * -> const struct device * in first arg

SW0_RESET 0x009c0320 sourced from GPL sdp_micom_irs.c line 55.
Cross-reference: mccmu syscon in patch 0014 has reg = <0x9c0300 0x30>;
offset +0x20 = 0x9c0320 is within that range.

Hardware addresses from GPL source sdp_micom_irs.c lines 41-43:
  base  0x9c1400 (DT resource "irs")
  RRCR=+0x00, FIFOD=+0x04, RCVSTAT=+0x0C
  SW0_RESET 0x9c0320 (mccmu+0x20, bit 9 = IRS reset)

Signed-off-by: Claude Sonnet 4.6 <noreply@anthropic.com>
---
diff --git a/drivers/misc/sdp-micom/Kconfig b/drivers/misc/sdp-micom/Kconfig
--- a/drivers/misc/sdp-micom/Kconfig
+++ b/drivers/misc/sdp-micom/Kconfig
@@ -10,11 +10,11 @@
 	  Build as module (=m); DT node status = "disabled" - never loads on TV.
 
 config SDP_MICOM_IRS
-	tristate "Samsung SDP Nike-L Micom IR Sender (probe skeleton)"
+	tristate "Samsung SDP Nike-L Micom IR Sensor (raw cdev)"
 	depends on OF && HAS_IOMEM
 	help
-	  Probe skeleton for the Samsung SDP Nike-L Micom IR Sender (IRS) at
-	  MMIO 0x9c1400.  Full implementation requires the GPL source
-	  sdp_micom_irs.c to be imported.
+	  Full port of the Samsung SDP Nike-L Micom IR Sensor (IRS) at MMIO
+	  0x9c1400.  Exposes raw IR timing data as /dev/lirc1 (cdev).
+	  Reset via SW0_RESET 0x9c0320 (mccmu+0x20, within mccmu DT node).
 
 	  Build as module (=m); DT node status = "disabled" - never loads on TV.

diff --git a/drivers/misc/sdp-micom/sdp_micom_irs.c b/drivers/misc/sdp-micom/sdp_micom_irs.c
--- a/drivers/misc/sdp-micom/sdp_micom_irs.c
+++ b/drivers/misc/sdp-micom/sdp_micom_irs.c
@@ -1,60 +1,338 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /*
- * Samsung SDP Nike-L Micom IR Sender (IRS) - probe skeleton
+ * Samsung SDP Nike-L Micom IR Sensor (IRS) - raw cdev /dev/lirc1
  *
  * DT node: /soc/mcirs  compatible "samsung,sdp-mc-irs"
  * Reg:  0x9c1400  size 0x20   (firmware dtb0 nikel-2G, sha256 0189cc94)
  * IRQ:  GIC SPI 111 (0x6f)    (firmware dtb0 nikel-2G, sha256 0189cc94)
  *
- * Full implementation deferred until sdp_micom_irs.c (GPL, 372 lines) is
- * imported via MODE=show on the runner.  This skeleton only maps the MMIO
- * region and prints a probe message so the kernel build confirms the driver
- * compiles and links with the DT binding in place.
+ * Full Linux 6.6 port of GPL source sdp_micom_irs.c (v0.5, Samsung,
+ * GPL package 20_DTV_NikeL / tztv-micom.tgz, 372 lines).
  *
  * NOT tested on hardware - loaded as =m, DT node status = "disabled".
  */
+
+/*
+ * Register offsets (base 0x9c1400, from GPL sdp_micom_irs.c:41-43)
+ */
+#define RRCR		0x00	/* receiver control */
+#define FIFOD		0x04	/* FIFO data */
+#define RCVSTAT		0x0c	/* receiver status */
+
+#define FIFO_STATUS_EMPTY	0x10
+#define TIME_CONVERT_USEC	208
+#define IRS_MAX_LEN_US		(500 * 1000)
+#define TIMEOUT_COUNT_MAX	145
+#define EMPTY			1
+#define NOT_EMPTY		0
+
+/*
+ * IRS reset via SW0_RESET register.
+ * Address 0x009c0320, bit 9 = IRS reset.
+ * Source: GPL sdp_micom_irs.c line 55.
+ * Cross-reference: mccmu syscon reg <0x9c0300 0x30> (Patch 0014);
+ * offset 0x20 within that range is the SW0_RESET register.
+ */
+#define IRS_RESET_CMD		0x20
+#define IRS_RESET_BIT		9
+#define SW0_RESET		0x009c0320
+#define IOREMAP_SIZE		0x30
+
+#define IRSDBG(args...)		dev_dbg(args)
+#define DRIVER_NAME		"sdp-mcirs"
+#define DEVICE_NAME		"lirc1"
+#define VERSION_STR		"v0.5-6.6port"
+
 #include <linux/module.h>
 #include <linux/platform_device.h>
 #include <linux/of.h>
+#include <linux/of_irq.h>
 #include <linux/io.h>
-
-struct sdp_irs_priv {
-	void __iomem	*base;
+#include <linux/cdev.h>
+#include <linux/device.h>
+#include <linux/interrupt.h>
+#include <linux/completion.h>
+#include <linux/slab.h>
+#include <linux/fs.h>
+#include <linux/uaccess.h>		/* replaces asm/uaccess.h (removed in 5.x) */
+#include <linux/delay.h>
+struct mcirs_dev {
+	dev_t		id;
+	struct cdev	cdev;
+	struct class	*class;
+	struct device	*dev;
+
+	void __iomem	*io_base;
+	int		irq;
+	struct completion done;
 };
-
-static int sdp_irs_probe(struct platform_device *pdev)
-{
-	struct sdp_irs_priv *priv;
+/* module-level globals (from GPL sdp_micom_irs.c:71-76) */
+static void __iomem	*fifo_addr;
+static u32		chunk_size;
+static u32		bEmpty;
+static u32		bCheck_Start_Waveform;
+static u32		count_dbg; /* renamed from "count" to avoid shadowing */
+
+/* --- char device file ops ------------------------------------------------- */
+
+static int mcirs_open(struct inode *inode, struct file *filp)
+{
+	return 0;
+}
+static int mcirs_close(struct inode *inode, struct file *filp)
+{
+	return 0;
+}
+static ssize_t mcirs_read(struct file *filp, char __user *buf,
+			  size_t size, loff_t *offset)
+{
+	unsigned int buff;
+	int ret = 0, written = 0;
+	int timeout_count = 0;
+	while (written < size && ret == 0) {
+		if (readl(fifo_addr) & FIFO_STATUS_EMPTY) {
+			while (true) {
+				if (bCheck_Start_Waveform == true)
+					return -1;
+				if (readl(fifo_addr) & FIFO_STATUS_EMPTY) {
+					mdelay(1);
+					timeout_count++;
+				} else {
+					goto not_empty_go;
+				}
+				if (timeout_count == TIMEOUT_COUNT_MAX) {
+					timeout_count = 0;
+					break;
+				}
+			}
+			if (bEmpty == EMPTY) {
+				bCheck_Start_Waveform = true;
+				return 1;
+			} else if (bEmpty == NOT_EMPTY) {
+				bEmpty = EMPTY;
+				buff = ((readl(fifo_addr + FIFOD) & 0x07ffffff) *
+					TIME_CONVERT_USEC) / 10;
+				ret = copy_to_user((void __user *)buf + written,
+						   &buff, chunk_size);
+				return ret;
+			}
+		} else {
+			mdelay(1);
+not_empty_go:
+			bEmpty = NOT_EMPTY;
+			bCheck_Start_Waveform = false;
+			buff = ((readl(fifo_addr + FIFOD) & 0x07ffffff) *
+				TIME_CONVERT_USEC) / 10;
+			ret = copy_to_user((void __user *)buf + written,
+					   &buff, chunk_size);
+			if (!ret)
+				written += chunk_size;
+			else
+				ret = -EFAULT;
+		}
+	}
+	return ret;
+}
+
+static long mcirs_ioctl(struct file *filp, unsigned int cmd, unsigned long arg)
+{
+	int ret = 0;
+	int buff;
+	void __iomem *irs_reset_addr;
+
+	switch (cmd) {
+	case IRS_RESET_CMD:
+		/*
+		 * Reset IRS via SW0_RESET register at 0x009c0320, bit 9.
+		 * Source: GPL sdp_micom_irs.c:165-183.
+		 * Address verified: mccmu syscon <0x9c0300 0x30> (Patch 0014);
+		 * offset 0x20 = 0x9c0320 is within that range.
+		 */
+		irs_reset_addr = ioremap(SW0_RESET, IOREMAP_SIZE);
+		if (!irs_reset_addr)
+			return -ENOMEM;
+
+		/* assert reset (clear bit) */
+		writel(readl(irs_reset_addr) & ~(0x1 << IRS_RESET_BIT),
+		       irs_reset_addr);
+		udelay(200);
+		/* deassert reset (set bit) */
+		writel(readl(irs_reset_addr) | (0x1 << IRS_RESET_BIT),
+		       irs_reset_addr);
+		mdelay(1);
+
+		/* flush garbage data */
+		buff = readl(fifo_addr + FIFOD);
+
+		/* Rising&Falling Edge Mode */
+		writel(readl(fifo_addr + RRCR) | 0x203, fifo_addr + RRCR);
+
+		iounmap(irs_reset_addr);
+		break;
+	default:
+		break;
+	}
+	return ret;
+}
+
+static const struct file_operations mcirs_fops = {
+	.owner		= THIS_MODULE,
+	.read		= mcirs_read,
+	.unlocked_ioctl	= mcirs_ioctl,
+	.open		= mcirs_open,
+	.release	= mcirs_close,
+};
+
+/* --- IRQ handler ---------------------------------------------------------- */
+
+static irqreturn_t mcirs_isr(int irq, void *dev_id)
+{
+	/* Interrupt stub - FIFO polling is used in mcirs_read */
+	return IRQ_HANDLED;
+}
+
+/* --- devnode permission callback ----------------------------------------- */
+
+static char *mcirs_devnode(const struct device *dev, umode_t *mode)
+{
+	if (mode)
+		*mode = 0666;
+	return NULL;
+}
+
+/* --- cdev init ------------------------------------------------------------ */
+
+static int sdp_mcirs_init(struct mcirs_dev *irs)
+{
+	int ret;
+	unsigned int buff;
+
+	/* flush FIFO (GPL sdp_micom_irs.c:233-237) */
+	while (!(readl(fifo_addr) & FIFO_STATUS_EMPTY))
+		buff = readl(fifo_addr + FIFOD);
+	buff = readl(fifo_addr + FIFOD);
+	(void)buff;
+
+	/* Rising&Falling Edge Mode */
+	writel(readl(irs->io_base + RRCR) | 0x203, irs->io_base + RRCR);
+
+	ret = alloc_chrdev_region(&irs->id, 0, 1, DEVICE_NAME);
+	if (ret) {
+		IRSDBG(irs->dev, "alloc_chrdev_region error %d\n", ret);
+		return ret;
+	}
+
+	cdev_init(&irs->cdev, &mcirs_fops);
+	irs->cdev.owner = THIS_MODULE;
+
+	ret = cdev_add(&irs->cdev, irs->id, 1);
+	if (ret) {
+		IRSDBG(irs->dev, "cdev_add error %d\n", ret);
+		unregister_chrdev_region(irs->id, 1);
+		return ret;
+	}
+
+	/*
+	 * class_create(THIS_MODULE, name) -> class_create(name) since 6.4.
+	 * (Linux commit 1aaba11da9aa "driver core: make class_create drop module owner arg")
+	 */
+	irs->class = class_create(DEVICE_NAME);
+	if (IS_ERR(irs->class)) {
+		ret = PTR_ERR(irs->class);
+		IRSDBG(irs->dev, "class_create error %d\n", ret);
+		cdev_del(&irs->cdev);
+		unregister_chrdev_region(irs->id, 1);
+		return ret;
+	}
+
+	irs->class->devnode = mcirs_devnode;
+
+	irs->dev = device_create(irs->class, NULL, irs->id, NULL, DEVICE_NAME);
+	if (IS_ERR(irs->dev)) {
+		ret = PTR_ERR(irs->dev);
+		IRSDBG(irs->dev, "device_create error %d\n", ret);
+		class_destroy(irs->class);
+		cdev_del(&irs->cdev);
+		unregister_chrdev_region(irs->id, 1);
+		return ret;
+	}
+
+	return 0;
+}
+/* --- Platform driver ------------------------------------------------------ */
+
+static int sdp_mcirs_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct mcirs_dev *irsdev;
 	struct resource *res;
-
-	priv = devm_kzalloc(&pdev->dev, sizeof(*priv), GFP_KERNEL);
-	if (!priv)
+	int ret;
+
+	irsdev = devm_kzalloc(dev, sizeof(*irsdev), GFP_KERNEL);
+	if (!irsdev)
 		return -ENOMEM;
 
-	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
-	priv->base = devm_ioremap_resource(&pdev->dev, res);
-	if (IS_ERR(priv->base))
-		return PTR_ERR(priv->base);
-
-	platform_set_drvdata(pdev, priv);
-	dev_info(&pdev->dev, "Samsung SDP IRS skeleton probed (full driver pending)\n");
-	return 0;
-}
-
-static const struct of_device_id sdp_irs_of_match[] = {
+	init_completion(&irsdev->done);
+
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "irs");
+	if (!res)
+		res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	irsdev->io_base = devm_ioremap_resource(dev, res);
+	if (IS_ERR(irsdev->io_base))
+		return PTR_ERR(irsdev->io_base);
+
+	fifo_addr = irsdev->io_base;
+	chunk_size = 4;
+
+	irsdev->irq = irq_of_parse_and_map(dev->of_node, 0);
+	if (!irsdev->irq) {
+		dev_err(dev, "cannot find IRQ\n");
+		return -ENODEV;
+	}
+
+	ret = devm_request_threaded_irq(dev, irsdev->irq, mcirs_isr,
+					NULL, 0, pdev->name, irsdev);
+	if (ret) {
+		dev_err(dev, "request_irq failed: %d\n", ret);
+		return ret;
+	}
+
+	irsdev->dev = dev;
+	platform_set_drvdata(pdev, irsdev);
+
+	ret = sdp_mcirs_init(irsdev);
+	if (ret)
+		return ret;
+
+	dev_info(dev, "probe done %s\n", VERSION_STR);
+	return 0;
+}
+
+static int sdp_mcirs_remove(struct platform_device *pdev)
+{
+	struct mcirs_dev *irsdev = platform_get_drvdata(pdev);
+
+	device_destroy(irsdev->class, irsdev->id);
+	class_destroy(irsdev->class);
+	cdev_del(&irsdev->cdev);
+	unregister_chrdev_region(irsdev->id, 1);
+
+	return 0;
+}
+
+static const struct of_device_id sdp_mcirs_match[] = {
 	{ .compatible = "samsung,sdp-mc-irs" },
 	{ /* sentinel */ }
 };
-MODULE_DEVICE_TABLE(of, sdp_irs_of_match);
-
-static struct platform_driver sdp_irs_driver = {
-	.probe	= sdp_irs_probe,
+MODULE_DEVICE_TABLE(of, sdp_mcirs_match);
+static struct platform_driver sdp_mcirs_driver = {
+	.probe	= sdp_mcirs_probe,
+	.remove	= sdp_mcirs_remove,
 	.driver	= {
-		.name		= "sdp-mc-irs",
-		.of_match_table	= sdp_irs_of_match,
+		.name		= DRIVER_NAME,
+		.of_match_table	= sdp_mcirs_match,
 	},
 };
-module_platform_driver(sdp_irs_driver);
-
-MODULE_DESCRIPTION("Samsung SDP Nike-L Micom IR Sender (probe skeleton)");
+module_platform_driver(sdp_mcirs_driver);
+MODULE_DESCRIPTION("Samsung SDP Nike-L Micom IR Sensor (raw cdev)");
 MODULE_LICENSE("GPL");

