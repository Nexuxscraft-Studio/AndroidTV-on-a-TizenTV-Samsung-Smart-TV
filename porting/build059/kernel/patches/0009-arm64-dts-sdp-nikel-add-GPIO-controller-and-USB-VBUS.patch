From cd4270891549edfdfd8ecd9c9f70ab548215a7ff Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 10 Nov 2026 22:07:02 +0100
Subject: [PATCH 9/9] arm64: dts: sdp-nikel: add GPIO controller and USB VBUS
 regulator

The GPIO controller is enabled (probe is read-only). The USB VBUS
switch (GPIO 86, from the firmware usben node) is described as a fixed
regulator and stays disabled together with the USB controllers.
---
 .../arm64/boot/dts/samsung-sdp/sdp-nikel.dtsi | 30 +++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/arch/arm64/boot/dts/samsung-sdp/sdp-nikel.dtsi b/arch/arm64/boot/dts/samsung-sdp/sdp-nikel.dtsi
index 08690cdd7..9fc98a28f 100644
--- a/arch/arm64/boot/dts/samsung-sdp/sdp-nikel.dtsi
+++ b/arch/arm64/boot/dts/samsung-sdp/sdp-nikel.dtsi
@@ -11,6 +11,7 @@
  */
 
 #include <dt-bindings/clock/samsung,sdp1804-clk.h>
+#include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/interrupt-controller/arm-gic.h>
 #include <dt-bindings/interrupt-controller/irq.h>
 
@@ -89,6 +90,21 @@ fin_pll: clock-24000000 {
 		clock-output-names = "fin_pll";
 	};
 
+	/*
+	 * USB VBUS switch: firmware "usben" node, samsung,usb-enable =
+	 * <&gpio10 6 0> (bank 10, pin 6 = GPIO 86), driven high by Samsung's
+	 * usb_enable driver. Disabled together with the USB controllers.
+	 */
+	reg_usb_vbus: regulator-usb-vbus {
+		compatible = "regulator-fixed";
+		regulator-name = "usb-vbus";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		gpio = <&gpio 86 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		status = "disabled";
+	};
+
 	pmu {
 		compatible = "arm,cortex-a57-pmu";
 		interrupts = <GIC_SPI 220 IRQ_TYPE_LEVEL_HIGH>,
@@ -117,6 +133,20 @@ gic: interrupt-controller@431000 {
 		 * The firmware tree uses child nodes with "sdp,clock"; this
 		 * tree uses a single provider with indices instead.
 		 */
+		/*
+		 * 28 banks x 8 pins from offset 0x1c0 (firmware: start-offset,
+		 * nr-banks). Pin n of bank b is GPIO b * 8 + n. Probing does not
+		 * change any pin, so the node is enabled for diagnostics.
+		 */
+		gpio: gpio-controller@f52000 {
+			compatible = "samsung,sdp-gpio";
+			reg = <0x00f52000 0x400>;
+			samsung,start-offset = <0x1c0>;
+			samsung,nr-banks = <28>;
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
 		clock: clock-controller@f50000 {
 			compatible = "samsung,sdp1804-clock";
 			reg = <0x00f50000 0x3000>;
-- 
