diff --git a/arch/arm64/boot/dts/samsung-sdp/sdp-nikel.dtsi b/arch/arm64/boot/dts/samsung-sdp/sdp-nikel.dtsi
index 0f53c81c3..3ef68cc59 100644
--- a/arch/arm64/boot/dts/samsung-sdp/sdp-nikel.dtsi
+++ b/arch/arm64/boot/dts/samsung-sdp/sdp-nikel.dtsi
@@ -293,6 +293,29 @@ msgbox: mailbox@9c0400 {
 			interrupts = <GIC_SPI 34 IRQ_TYPE_NONE>;
 			status = "disabled";
 		};
+
+		/*
+		 * Micom clock/reset unit (firmware /soc/mccmu: compatible
+		 * "samsung,sdp-mc-cmu", "syscon", reg <0x9c0300 0x30>).
+		 * Offset 0x20 bit 1 resets the CEC controller.
+		 */
+		mccmu: syscon@9c0300 {
+			compatible = "samsung,sdp-mc-cmu", "syscon";
+			reg = <0x009c0300 0x30>;
+		};
+
+		/*
+		 * HDMI-CEC controller shared with the Micom (firmware
+		 * /soc/cecif: reg <0x9c0f00 0x48>, interrupts <0 0x27 0>,
+		 * samsung,mccmu; disabled in the firmware DT as well).
+		 */
+		cec@9c0f00 {
+			compatible = "samsung,sdp-mc-cecif";
+			reg = <0x009c0f00 0x48>;
+			interrupts = <GIC_SPI 39 IRQ_TYPE_NONE>;
+			samsung,mccmu = <&mccmu>;
+			status = "disabled";
+		};
 	};
 
