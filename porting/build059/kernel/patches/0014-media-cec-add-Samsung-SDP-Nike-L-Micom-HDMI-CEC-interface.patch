 drivers/media/cec/platform/Kconfig            |  11 +
 drivers/media/cec/platform/Makefile           |   1 +
 drivers/media/cec/platform/sdp/Makefile       |   2 +
 drivers/media/cec/platform/sdp/sdp-cecif.c    | 475 ++++++++++++++++++
 5 files changed, 512 insertions(+)
 create mode 100644 drivers/media/cec/platform/sdp/Makefile
