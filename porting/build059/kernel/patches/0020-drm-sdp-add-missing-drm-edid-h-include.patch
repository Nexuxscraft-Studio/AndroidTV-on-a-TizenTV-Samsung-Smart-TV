From c6bcf7d6f08583ba283974a2a227149fd0ec943f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 12 Nov 2026 13:37:23 +0100
Subject: [PATCH] drm/sdp: add missing drm_edid.h include (patch 0020)

drm_add_modes_noedid() and drm_set_preferred_mode() are declared in
<drm/drm_edid.h>. Without this include clang raises
-Wimplicit-function-declaration with -Werror causing the build to fail.

Fixes: patch 0015 (drm/sdp: minimal Nike-L KMS driver)

Signed-off-by: Claude Sonnet 4.6 <noreply@anthropic.com>
Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HFSjk2L7MPX5r9CMRGhqwJ
---
 drivers/gpu/drm/sdp/sdp_drm.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/gpu/drm/sdp/sdp_drm.c b/drivers/gpu/drm/sdp/sdp_drm.c
index 176033c64..f2a5a83c1 100644
--- a/drivers/gpu/drm/sdp/sdp_drm.c
+++ b/drivers/gpu/drm/sdp/sdp_drm.c
@@ -40,6 +40,7 @@
 
 #include <drm/drm_atomic_helper.h>
 #include <drm/drm_connector.h>
+#include <drm/drm_edid.h>
 #include <drm/drm_drv.h>
 #include <drm/drm_fb_dma_helper.h>
 #include <drm/drm_fbdev_dma.h>
-- 
2.43.0

