From 60316b85415bb74cc2d51a80b308d12b6701e4ba Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 10 Nov 2026 21:48:52 +0100
Subject: [PATCH 4/5] clk: add read-only Samsung SDP1804 (Nike-L) clock driver

Expose the PLLs of the Samsung SDP1804 "Nike-L" DTV SoC and the fixed
dividers derived from them (arm_clk, apb_pclk, ddr2/3_clk, emmc_clk).

PLL offsets, the pll2xxxx rate formula and the dividers follow Samsung's
GPL driver drivers/clk/clk-sdp.c from linux-4.1.10-tizen5.5. Unlike the
original, this driver is strictly read-only: it never reprograms a PLL
and registers no gates.
---
 .../bindings/clock/samsung,sdp1804-clock.yaml |  47 +++++
 drivers/clk/Kconfig                           |  10 +
 drivers/clk/Makefile                          |   1 +
 drivers/clk/clk-sdp1804.c                     | 198 ++++++++++++++++++
 .../dt-bindings/clock/samsung,sdp1804-clk.h   |  32 +++
 5 files changed, 288 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/clock/samsung,sdp1804-clock.yaml
 create mode 100644 drivers/clk/clk-sdp1804.c
 create mode 100644 include/dt-bindings/clock/samsung,sdp1804-clk.h

diff --git a/Documentation/devicetree/bindings/clock/samsung,sdp1804-clock.yaml b/Documentation/devicetree/bindings/clock/samsung,sdp1804-clock.yaml
new file mode 100644
index 000000000..7f47baba7
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/samsung,sdp1804-clock.yaml
@@ -0,0 +1,47 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/samsung,sdp1804-clock.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung SDP1804 (Nike-L) clock controller
+
+maintainers:
+  - Nexuxscraft-Studio Samsung-ATV-Lab
+
+description:
+  Clock and reset block of the Samsung SDP1804 "Nike-L" DTV SoC. The
+  current driver only reads back the PLLs configured by the boot loader
+  and the fixed dividers derived from them. Clock indices are defined in
+  include/dt-bindings/clock/samsung,sdp1804-clk.h.
+
+properties:
+  compatible:
+    const: samsung,sdp1804-clock
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: 24 MHz PLL input clock (fin_pll)
+
+  "#clock-cells":
+    const: 1
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - "#clock-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    clock-controller@f50000 {
+        compatible = "samsung,sdp1804-clock";
+        reg = <0x00f50000 0x3000>;
+        clocks = <&fin_pll>;
+        #clock-cells = <1>;
+    };
