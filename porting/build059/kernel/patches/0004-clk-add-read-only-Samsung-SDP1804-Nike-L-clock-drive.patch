diff --git a/drivers/clk/clk-sdp1804.c b/drivers/clk/clk-sdp1804.c
new file mode 100644
index 000000000..dcddb6dfb
--- /dev/null
+++ b/drivers/clk/clk-sdp1804.c
@@ -0,0 +1,198 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung SDP1804 (Nike-L) clock controller, read-only part
+ *
+ * PLL layout, register offsets and the fixed dividers come from Samsung's
+ * GPL driver drivers/clk/clk-sdp.c (linux-4.1.10-tizen5.5, release
+ * 20_DTV_NikeL), Copyright (C) 2013 Samsung Electronics Co. Ltd.
+ *
+ * This driver only reads the PLL configuration left by the boot loader and
+ * exposes the resulting rates. It never reprograms a PLL and registers no
+ * gates, so it cannot switch anything off.
+ */
+
+#include <linux/clk-provider.h>
+#include <linux/io.h>
+#include <linux/math64.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/overflow.h>
+#include <linux/slab.h>
+
+#include <dt-bindings/clock/samsung,sdp1804-clk.h>
+
+#define PLL_MDIV_SHIFT	8
+#define PLL_MDIV_MASK	0x3ff
+#define PLL_PDIV_SHIFT	20
+#define PLL_PDIV_MASK	0x3f
+#define PLL_SDIV_SHIFT	0
+#define PLL_SDIV_MASK	0x7
+#define PLL_K_MASK	0xffff
+
+struct sdp1804_pll_desc {
+	unsigned int id;
+	const char *name;
+	u32 off_pms;
+	u32 off_k;
+};
+
+static const struct sdp1804_pll_desc sdp1804_plls[] __initconst = {
+	{ SDP1804_COREPLL0, "COREPLL0", 0x000, 0x004 },
+	{ SDP1804_CPUPLL,   "CPUPLL",   0x01c, 0x020 },
+	{ SDP1804_PULLPLL0, "PULLPLL0", 0x038, 0x03c },
+	{ SDP1804_PULLPLL1, "PULLPLL1", 0x054, 0x058 },
+	{ SDP1804_FRCPLL,   "FRCPLL",   0x070, 0x074 },
+	{ SDP1804_COREPLL1, "COREPLL1", 0x08c, 0x090 },
+	{ SDP1804_COREPLL2, "COREPLL2", 0x0a8, 0x0ac },
+	{ SDP1804_USITPLL,  "USITPLL",  0x0c4, 0x0c8 },
+	{ SDP1804_DPPLL,    "DPPLL",    0x0e0, 0x0e4 },
+	{ SDP1804_AUDPLL0,  "AUDPLL0",  0x0fc, 0x100 },
+	{ SDP1804_AUDPLL1,  "AUDPLL1",  0x118, 0x11c },
+	{ SDP1804_DDRPLL2,  "DDRPLL2",  0x134, 0x138 },
+	{ SDP1804_DDRPLL3,  "DDRPLL3",  0x150, 0x154 },
+};
+
+struct sdp1804_div_desc {
+	unsigned int id;
+	const char *name;
+	unsigned int parent;
+	unsigned int div;
+};
+
+static const struct sdp1804_div_desc sdp1804_divs[] __initconst = {
+	{ SDP1804_ARM_CLK,  "arm_clk",  SDP1804_CPUPLL,   1 },
+	{ SDP1804_APB_PCLK, "apb_pclk", SDP1804_COREPLL0, 8 },
+	{ SDP1804_DDR2_CLK, "ddr2_clk", SDP1804_DDRPLL2,  2 },
+	{ SDP1804_DDR3_CLK, "ddr3_clk", SDP1804_DDRPLL3,  2 },
+	{ SDP1804_EMMC_CLK, "emmc_clk", SDP1804_COREPLL2, 2 },
+};
+
+struct sdp1804_pll {
+	struct clk_hw hw;
+	void __iomem *reg_pms;
+	void __iomem *reg_k;
+};
+
+#define to_sdp1804_pll(_hw) container_of(_hw, struct sdp1804_pll, hw)
+
+/* Samsung "pll2xxxx": f_out = (f_in * m + (f_in * k) >> 16) / (p * 2^s) */
+static unsigned long sdp1804_pll_recalc_rate(struct clk_hw *hw,
+					     unsigned long parent_rate)
+{
+	struct sdp1804_pll *pll = to_sdp1804_pll(hw);
+	u32 pms = readl_relaxed(pll->reg_pms);
+	u32 mdiv = (pms >> PLL_MDIV_SHIFT) & PLL_MDIV_MASK;
+	u32 pdiv = (pms >> PLL_PDIV_SHIFT) & PLL_PDIV_MASK;
+	u32 sdiv = (pms >> PLL_SDIV_SHIFT) & PLL_SDIV_MASK;
+	s16 k = (s16)(readl_relaxed(pll->reg_k) & PLL_K_MASK);
+	s64 fout;
+
+	if (!pdiv)
+		return 0;
+
+	fout = (s64)parent_rate * mdiv + (((s64)parent_rate * k) >> 16);
+	if (fout <= 0)
+		return 0;
+
+	return div_u64((u64)fout, pdiv << sdiv);
+}
+
+static const struct clk_ops sdp1804_pll_ops = {
+	.recalc_rate = sdp1804_pll_recalc_rate,
+};
+
+static struct clk_hw * __init sdp1804_register_pll(void __iomem *base,
+						   const struct sdp1804_pll_desc *d,
+						   const char *parent)
+{
+	struct clk_init_data init = { };
+	struct sdp1804_pll *pll;
+	int ret;
+
+	pll = kzalloc(sizeof(*pll), GFP_KERNEL);
+	if (!pll)
+		return ERR_PTR(-ENOMEM);
+
+	init.name = d->name;
+	init.ops = &sdp1804_pll_ops;
+	init.parent_names = &parent;
+	init.num_parents = 1;
+	/* rates are owned by the boot loader; always read them back */
+	init.flags = CLK_GET_RATE_NOCACHE;
+
+	pll->hw.init = &init;
+	pll->reg_pms = base + d->off_pms;
+	pll->reg_k = base + d->off_k;
+
+	ret = clk_hw_register(NULL, &pll->hw);
+	if (ret) {
+		kfree(pll);
+		return ERR_PTR(ret);
+	}
+	return &pll->hw;
+}
+
+static void __init sdp1804_clk_init(struct device_node *np)
+{
+	struct clk_hw_onecell_data *data;
+	const char *parent;
+	void __iomem *base;
+	struct clk_hw *hw;
+	unsigned int i;
+
+	parent = of_clk_get_parent_name(np, 0);
+	if (!parent) {
+		pr_err("%pOF: missing input clock (fin_pll)\n", np);
+		return;
+	}
+
+	base = of_iomap(np, 0);
+	if (!base) {
+		pr_err("%pOF: cannot map registers\n", np);
+		return;
+	}
+
+	data = kzalloc(struct_size(data, hws, SDP1804_NR_CLKS), GFP_KERNEL);
+	if (!data)
+		goto err_unmap;
+	data->num = SDP1804_NR_CLKS;
+	for (i = 0; i < SDP1804_NR_CLKS; i++)
+		data->hws[i] = ERR_PTR(-ENOENT);
+
+	for (i = 0; i < ARRAY_SIZE(sdp1804_plls); i++) {
+		const struct sdp1804_pll_desc *d = &sdp1804_plls[i];
+
+		hw = sdp1804_register_pll(base, d, parent);
+		if (IS_ERR(hw))
+			pr_err("%pOF: %s: %ld\n", np, d->name, PTR_ERR(hw));
+		data->hws[d->id] = hw;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(sdp1804_divs); i++) {
+		const struct sdp1804_div_desc *d = &sdp1804_divs[i];
+		struct clk_hw *p = data->hws[d->parent];
+
+		if (IS_ERR(p))
+			continue;
+		hw = clk_hw_register_fixed_factor(NULL, d->name,
+						  clk_hw_get_name(p), 0, 1,
+						  d->div);
+		if (IS_ERR(hw))
+			pr_err("%pOF: %s: %ld\n", np, d->name, PTR_ERR(hw));
+		data->hws[d->id] = hw;
+	}
+
+	for (i = 0; i < SDP1804_NR_CLKS; i++)
+		if (!IS_ERR(data->hws[i]))
+			pr_info("sdp1804-clk: %-9s %lu Hz\n",
+				clk_hw_get_name(data->hws[i]),
+				clk_hw_get_rate(data->hws[i]));
+
+	if (of_clk_add_hw_provider(np, of_clk_hw_onecell_get, data))
+		pr_err("%pOF: cannot add clock provider\n", np);
+	return;
+
+err_unmap:
+	iounmap(base);
+}
+CLK_OF_DECLARE(sdp1804_clk, "samsung,sdp1804-clock", sdp1804_clk_init);
diff --git a/include/dt-bindings/clock/samsung,sdp1804-clk.h b/include/dt-bindings/clock/samsung,sdp1804-clk.h
new file mode 100644
index 000000000..44b0b94b1
--- /dev/null
+++ b/include/dt-bindings/clock/samsung,sdp1804-clk.h
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause) */
+/*
+ * Clock indices of the Samsung SDP1804 (Nike-L) clock controller.
+ */
+#ifndef _DT_BINDINGS_CLOCK_SAMSUNG_SDP1804_H
+#define _DT_BINDINGS_CLOCK_SAMSUNG_SDP1804_H
+
+/* PLLs (rates read back from hardware) */
+#define SDP1804_COREPLL0	0
+#define SDP1804_CPUPLL		1
+#define SDP1804_PULLPLL0	2
+#define SDP1804_PULLPLL1	3
+#define SDP1804_FRCPLL		4
+#define SDP1804_COREPLL1	5
+#define SDP1804_COREPLL2	6
+#define SDP1804_USITPLL		7
+#define SDP1804_DPPLL		8
+#define SDP1804_AUDPLL0		9
+#define SDP1804_AUDPLL1		10
+#define SDP1804_DDRPLL2		11
+#define SDP1804_DDRPLL3		12
+
+/* fixed dividers */
+#define SDP1804_ARM_CLK		13
+#define SDP1804_APB_PCLK	14
+#define SDP1804_DDR2_CLK	15
+#define SDP1804_DDR3_CLK	16
+#define SDP1804_EMMC_CLK	17
+
+#define SDP1804_NR_CLKS		18
+
+#endif
