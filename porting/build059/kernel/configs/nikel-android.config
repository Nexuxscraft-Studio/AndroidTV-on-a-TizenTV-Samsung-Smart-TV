# Build 059/069 - additions for the "android" profile (Android 15 userspace).
# multi_v7_defconfig/defconfig leave CONFIG_LSM without "selinux"; then
# SECURITY_SELINUX is built in but never initialised and Android first-stage
# init aborts on mount("selinuxfs") = EINVAL (measured in Build 069 M1, QEMU).
CONFIG_SECURITY_SELINUX=y
CONFIG_DEFAULT_SECURITY_SELINUX=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,selinux,bpf"
# SELinux labels live in "security.*" xattrs; without these, ext4/erofs/tmpfs
# files are "unlabeled" and second-stage init aborts on restorecon of
# /system/bin/init (measured in Build 069 M2, QEMU).
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
# Build 070: EROFS itself was only enabled by Build 069's qemu-virt.config; the
# shared Q60T kernel needs it too, else XATTR/SECURITY are lost (run 43187928745).
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
