# Build 070 - Q60T driver set, merged into the "android" profile (one shared
# kernel). Consolidates the Build 063-066 fragments (nikel-display, -gpu, -cpu,
# -soc-extra, -peripherals, -simpledrm). Only user-visible symbols are listed,
# because build.sh requires every line to survive olddefconfig. Dropped on
# purpose: CONFIG_COMPILE_TEST (ARCH_SDP=y is real here), selected-only helpers
# (DRM_KMS_HELPER, DRM_GEM_*_HELPER, DRM_SCHED, PM_OPP) and SYSFB/SYSFB_SIMPLEFB
# (X86||EFI only; simpledrm binds to a DT "simple-framebuffer" node instead).
# Everything is built in: no module has to be loaded on the TV.
# A driver only probes once its DT node exists with status = "okay"; no Nike-L
# DT node for display/GPU/audio/IR/CEC/Ethernet is added before its values are
# taken from the firmware dtb.bin (with the location noted).

# Display (P0): own KMS driver (patch 0012) + simpledrm framebuffer handoff
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SDP=y
CONFIG_DRM_SIMPLEDRM=y
# GPU (P0): Mali-G51 (Bifrost) via upstream Panfrost
CONFIG_DRM_PANFROST=y
CONFIG_IOMMU_SUPPORT=y
# CPU DVFS + thermal (P0): upstream cpufreq-dt / thermal-of, no own C driver
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPUFREQ_DT=y
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_CPU_THERMAL=y
CONFIG_CPU_IDLE=y
# IR remote (P1): rc-core + lirc; the Micom decodes the remote and reports
# key codes over the message box (patch 0013)
CONFIG_RC_CORE=y
CONFIG_LIRC=y
CONFIG_INPUT_EVDEV=y
CONFIG_RC_DEVICES=y
CONFIG_SDP_MSGBOX=y
CONFIG_SDP_MICOM=y
CONFIG_IR_SDP_MICOM=y
# Audio (P1): ASoC
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
# HDMI-CEC (P1): cec core + Micom CEC controller (patch 0014);
# video decode (P1): V4L2 mem2mem framework
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CEC_SUPPORT=y
CONFIG_CEC_SDP_CECIF=y
CONFIG_VIDEO_DEV=y
CONFIG_V4L_MEM2MEM_DRIVERS=y
# HDMI (P1): probe skeleton (patch 0018); no GPL source found, full
# implementation pending.  Built as module; DT node stays disabled.
CONFIG_DRM_SDP_HDMI=m
# Ethernet (P2): sdp_mac skeleton (patch 0017); full implementation pending
# sdp_mac.c GPL import.  Built as module so it can be loaded for probe testing
# without touching the TV; the DT node stays status="disabled" for now.
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_SDP=y
CONFIG_SDP_MAC=m
# IR Blaster/Receiver + IR Sender (P1): probe skeletons (patch 0019);
# GPL sources sdp_micom_irb.c (335 lines) / sdp_micom_irs.c (372 lines)
# available, full implementation pending MODE=show runner run.
# Built as modules; DT nodes stay status="disabled".
CONFIG_SDP_MICOM_IRB=m
CONFIG_SDP_MICOM_IRS=m
