# Build 059 - arm32 (ARMv7 + LPAE) specific settings, as in Samsung's
# Nike.M-Tizen defconfigs (CONFIG_CPU_V7, CONFIG_ARM_LPAE).
CONFIG_MMU=y
CONFIG_ARCH_MULTIPLATFORM=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARM_LPAE=y
CONFIG_ARM_PSCI=y
CONFIG_HIGHMEM=y
CONFIG_AEABI=y
CONFIG_VFP=y
CONFIG_VFPv3=y
CONFIG_NEON=y
