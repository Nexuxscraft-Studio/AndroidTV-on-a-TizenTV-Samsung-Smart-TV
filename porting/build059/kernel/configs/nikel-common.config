# Build 059 - Nike-L base kernel, settings shared by arm64 and arm32.
# Goal of this profile: boot to a shell on the serial console (initramfs).
CONFIG_ARCH_SDP=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_KALLSYMS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_TTY=y
CONFIG_SERIAL_SDP=y
CONFIG_SERIAL_SDP_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_COMMON_CLK_SDP1804=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MULTIUSER=y
CONFIG_PANIC_TIMEOUT=0
# eMMC (DesignWare MMC, Exynos glue); the DT node is still disabled
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_EXYNOS=y
# USB 2.0 host (generic EHCI/OHCI platform drivers); DT nodes still disabled
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_INPUT=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_USB_HID=y
# GPIO (enabled in DT, read-only at probe) and fixed regulators (USB VBUS)
CONFIG_GPIOLIB=y
CONFIG_GPIO_SDP=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
