# Build 069 – Auftrag für den self-hosted Runner ("debian").
# Ein Push dieser Datei (Branch claude/build069-*) startet
# .github/workflows/build069-android-qemu-boot.yml. Wird geparst und validiert,
# nicht gesourct.
#
# MODE            boot (Standard) | probe (lesende Quellen-Prüfung) | tombstones (Crash-Daten aus letztem userdata.img)
# LOS_DIR         LineageOS-Baum mit fertigem Build-068-Ergebnis
# TIMEOUT         QEMU-Laufzeitgrenze in Sekunden (TCG-Emulation ist langsam)
# SMP / MEM       vCPUs / RAM (MB) der QEMU-Maschine
# HARDWARE        androidboot.hardware (-> fstab.<HARDWARE> in der Ramdisk-Kopie)
# PRODUCT_DIR     generic (GSI, M1) | qemu_arm_tv (M2-Gerät mit vendor.img)
# REBUILD_KERNEL  0 | 1
# EXTRA_CMDLINE   zusätzliche Kernel-Parameter (nur [A-Za-z0-9._=,:/ -])
# REQUEST_ID      frei; ändert sich -> neuer Lauf

MODE=probe
LOS_DIR=/mnt/github-runner/lineage-22.2
TIMEOUT=1500
SMP=4
MEM=3072
HARDWARE=qemuarm
PRODUCT_DIR=qemu_arm_tv
REBUILD_KERNEL=0
EXTRA_CMDLINE=
REQUEST_ID=2026-11-11-m3-probe3c-memfd
