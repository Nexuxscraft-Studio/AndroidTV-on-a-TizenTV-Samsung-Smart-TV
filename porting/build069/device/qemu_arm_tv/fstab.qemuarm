# Build 069 M2 - QEMU virt, virtio-blk-pci in this order: system, vendor, userdata
/dev/block/vda  /system  ext4  ro,barrier=1                          wait,first_stage_mount
/dev/block/vdb  /vendor  ext4  ro,barrier=1                          wait,first_stage_mount
/dev/block/vdc  /data    ext4  noatime,nosuid,nodev,errors=panic     wait,check,formattable
