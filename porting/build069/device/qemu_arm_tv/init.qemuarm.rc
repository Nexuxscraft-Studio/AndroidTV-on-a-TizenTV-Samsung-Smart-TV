# Build 069 M2 - device init for QEMU virt (emulation only)
# --early mounts every non-first-stage entry WITHOUT "latemount" (here: /data);
# --late only those WITH it. Calling only --late left /data unmounted and
# apexd forced "reboot,apexd-failed" (M2-Boot 3).
on fs
    mount_all /vendor/etc/fstab.${ro.hardware} --early

on late-fs
    mount_all /vendor/etc/fstab.${ro.hardware} --late

on post-fs-data
    setprop vold.post_fs_data_done 1

# Diagnostics (emulation only): mirror warnings/errors and the crash buffer
# (debuggerd tombstone text) to the kernel log, i.e. the QEMU serial console.
service qemu_logcat_kmsg /system/bin/logcat -b crash -b main -b system -v brief -f /dev/kmsg *:W
    user root
    group root log
    disabled

on post-fs-data
    start qemu_logcat_kmsg
