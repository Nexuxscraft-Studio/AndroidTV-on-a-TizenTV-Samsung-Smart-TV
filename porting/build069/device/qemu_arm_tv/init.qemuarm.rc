# Build 069 M2 - device init for QEMU virt (emulation only)
# --early mounts every non-first-stage entry WITHOUT "latemount" (here: /data);
# --late only those WITH it. Calling only --late left /data unmounted and
# apexd forced "reboot,apexd-failed" (M2-Boot 3).
on fs
    mount_all /vendor/etc/fstab.${ro.hardware} --early

on late-fs
    mount_all /vendor/etc/fstab.${ro.hardware} --late

on post-fs-data
    setprop vold.post_fs_data_done 1

# Diagnostics (emulation only): mirror warnings/errors and the crash buffer
# (debuggerd tombstone text) to the kernel log = QEMU serial console.
# One kmsg record per line (logcat -f cannot open a char device), oneshot so
# that it can never count as a crashing service before boot completed.
service qemu_logcat_kmsg /system/bin/sh /vendor/bin/qemu_logcat_kmsg.sh
    user root
    group root log
    oneshot
    disabled

on post-fs-data
    start qemu_logcat_kmsg

# Boot 6: Linux 6.6 has no ashmem driver (CONFIG_ASHMEM is ACK-only), so
# system_server died with "Failed to create ashmem". libcutils uses memfd
# only when sys.use_memfd=true; system/core/rootdir/init.rc sets it to false,
# so force it back on whenever that happens.
on early-init
    setprop sys.use_memfd true

on property:sys.use_memfd=false
    setprop sys.use_memfd true

# Boot 9: display diagnostics (see qemu_display_diag.sh).
service qemu_display_diag /system/bin/sh /vendor/bin/qemu_display_diag.sh
    user root
    group root log graphics system
    oneshot
    disabled

on property:init.svc.surfaceflinger=running
    start qemu_display_diag
