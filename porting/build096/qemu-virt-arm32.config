# Build 096 - minimal Linux 6.6.162 ARM32 kernel for the QEMU "virt" board.
# Applied with KCONFIG_ALLCONFIG on top of allnoconfig. Generic virtual
# hardware only: no Samsung SoC driver, no Samsung MMIO, no board DT. QEMU
# generates the virt device tree itself and passes it to the kernel.
#
# Every line below must survive olddefconfig; build-qemu-kernel.sh fails
# otherwise.
CONFIG_MMU=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_VIRT=y
CONFIG_AEABI=y
# Cortex-A15 implements LPAE, like the Nike-L ARM32 profile uses
CONFIG_ARM_LPAE=y
CONFIG_ARM_PSCI=y
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
# Serial console on the virt PL011 (ttyAMA0)
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
# Separate gzip initramfs passed with -initrd
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BINFMT_ELF=y
CONFIG_PANIC_TIMEOUT=-1
# Nothing Samsung-specific may end up in this kernel
# CONFIG_MODULES is not set
# CONFIG_NET is not set
# CONFIG_DRM is not set
