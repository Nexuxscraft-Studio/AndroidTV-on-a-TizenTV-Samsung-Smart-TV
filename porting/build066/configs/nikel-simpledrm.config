# Build 066 - framebuffer handoff via upstream simpledrm.
# For a FIRST PICTURE without the proprietary VD display driver: if the
# bootloader leaves the panel on with an initialised framebuffer, simpledrm
# takes it over via a "simple-framebuffer" DT node (or sysfb). No custom
# display driver needed for this path. Compile coverage only.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_FBDEV_EMULATION=y
