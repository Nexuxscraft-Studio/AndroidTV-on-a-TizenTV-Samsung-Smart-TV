# Build 063 - CPU DVFS + thermal via upstream drivers (no custom C driver).
# Prefer cpufreq-dt over a custom sdp cpufreq driver: DVFS is expressed as DT
# operating-points-v2 + cpu clock + cpu-supply. Build 058 has a prototype C
# driver; the DT path is the cleaner target.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPUFREQ_DT=y
CONFIG_PM_OPP=y
# Thermal via DT thermal-zones + CPU cooling.
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_CPU_THERMAL=y
CONFIG_CPU_IDLE=y
