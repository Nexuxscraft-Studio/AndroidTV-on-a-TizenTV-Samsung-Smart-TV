# Build 063 - enable the Build 059 core-SoC nodes that are currently 'disabled'
# in the reference DT, for compile/boot-prep coverage. Each still needs the DT
# node set to status="okay" with verified clocks/resets/regulators.
# eMMC (dw_mmc-exynos) - P0 for a real boot target (partitions, data).
CONFIG_MMC=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_EXYNOS=y
CONFIG_BLK_DEV_INITRD=y
# USB EHCI/OHCI host (HID remotes, storage).
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_STORAGE=y
# Ethernet (samsung,sdp-mac) placeholder enable.
CONFIG_NETDEVICES=y
