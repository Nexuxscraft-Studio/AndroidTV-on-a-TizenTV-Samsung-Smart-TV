# Build 063 - GPU (Panfrost, open) compile coverage fragment.
# Mali-G51 is Bifrost (v7); upstream Panfrost supports it (GLES 3.1). No custom
# kernel GPU driver is needed - Panfrost is in-tree. Userspace (Mesa/gralloc/
# drm_hwcomposer) is covered in docs/GPU_INTEGRATION.md, not here.
CONFIG_DRM=y
CONFIG_DRM_SCHED=y
CONFIG_DRM_GEM_SHMEM_HELPER=y
CONFIG_DRM_PANFROST=m
CONFIG_IOMMU_SUPPORT=y
