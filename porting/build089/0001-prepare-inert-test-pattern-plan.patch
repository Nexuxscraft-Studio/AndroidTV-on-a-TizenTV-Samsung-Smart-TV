diff --git a/drivers/gpu/drm/sdp/sdp_drm_test_pattern.h b/drivers/gpu/drm/sdp/sdp_drm_test_pattern.h
new file mode 100644
index 0000000..c58e33b
--- /dev/null
+++ b/drivers/gpu/drm/sdp/sdp_drm_test_pattern.h
@@ -0,0 +1,74 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef SDP_DRM_TEST_PATTERN_H
+#define SDP_DRM_TEST_PATTERN_H
+
+#include <linux/errno.h>
+#include <linux/types.h>
+
+#include "sdp_drm_hw.h"
+
+#define SDP_TEST_WIDTH		1920U
+#define SDP_TEST_HEIGHT		1080U
+#define SDP_TEST_PITCH		(SDP_TEST_WIDTH * 4U)
+#define SDP_TEST_BYTES		(SDP_TEST_PITCH * SDP_TEST_HEIGHT)
+
+#define SDP_OSDP_SOURCE_SIZE		0x10
+#define SDP_OSDP_DESTINATION_SIZE	0x14
+#define SDP_OSDP_SOURCE_OFFSET		0x18
+#define SDP_MIXER_MAIN_ACTIVE_SIZE	0x20
+
+struct sdp_test_register {
+	enum sdp_register_bank bank;
+	u32 offset;
+	u32 value;
+};
+
+struct sdp_test_plan {
+	struct sdp_test_register geometry[7];
+	u32 gp_dma_address;
+};
+
+static inline u32 sdp_test_pixel(unsigned int x, unsigned int y)
+{
+	static const u32 colors[] = {
+		0xffffff, 0xffff00, 0x00ffff, 0x00ff00,
+		0xff00ff, 0xff0000, 0x0000ff, 0x000000,
+	};
+
+	if (y == 0 || y == SDP_TEST_HEIGHT - 1 || x == 0 ||
+	    x == SDP_TEST_WIDTH - 1)
+		return 0x808080;
+
+	return colors[x / (SDP_TEST_WIDTH / 8)];
+}
+
+/*
+ * Describe vendor geometry in RAM. OSDP geometry is a reference for the
+ * unscaled case, independent of the choice to route GP to the mixer.
+ * Keep the DMA address separate until the GP bus translation is verified.
+ */
+static inline int sdp_test_prepare_plan(u64 address, struct sdp_test_plan *plan)
+{
+	const u32 size = SDP_TEST_WIDTH << 16 | SDP_TEST_HEIGHT;
+	const u32 source_offset = SDP_TEST_WIDTH / 4;
+
+	if ((address & 3) || address > 0xffffffffULL - (SDP_TEST_BYTES - 1))
+		return -ERANGE;
+
+	*plan = (struct sdp_test_plan) {
+		.geometry = {
+			{ SDP_GP, SDP_GP_SOURCE_SIZE, size },
+			{ SDP_GP, SDP_GP_DESTINATION_SIZE, size },
+			{ SDP_GP, SDP_GP_SOURCE_OFFSET, source_offset },
+			{ SDP_OSDP, SDP_OSDP_SOURCE_SIZE, size },
+			{ SDP_OSDP, SDP_OSDP_DESTINATION_SIZE, size },
+			{ SDP_OSDP, SDP_OSDP_SOURCE_OFFSET, source_offset },
+			{ SDP_MIXER, SDP_MIXER_MAIN_ACTIVE_SIZE, size },
+		},
+		.gp_dma_address = (u32)address,
+	};
+
+	return 0;
+}
+
+#endif
