# Build 068 – Auftrag für den self-hosted Runner ("debian").
# Ein Push dieser Datei (Branch claude/build068-*) startet den Workflow
# .github/workflows/build068-selfhosted-userspace.yml.
# Die Datei wird NICHT per `source` gelesen, sondern zeilenweise geparst und
# gegen feste Werte geprüft. Kommentare und Leerzeilen sind erlaubt.
#
# MODE              preflight | build
#                   preflight = nur Host-Inventur (read-only, Minuten)
#                   build     = komplette Pipeline (Stunden, große Downloads)
# TARGET            sdk_tv_arm | gsi_tv_arm | qemu_arm_tv
# JOBS              Zahl oder "auto" (= nproc)
# FROM_STAGE        leer | deps | preflight | init | sync | check-target | build | verify | emulator | handback
# LOS_DIR           absoluter Pfad oder ~/... (Quellbaum, bleibt zwischen Läufen erhalten)
# INSTALL_DEPS      0 | 1   (braucht passwortloses sudo für apt-get)
# ALLOW_UNDERSIZED  0 | 1   (Host-Gate NOT READY trotzdem fortsetzen)
# FORCE             0 | 1   (fertige Stufen erneut ausführen)
# REQUEST_ID        frei, nur damit ein neuer Push einen neuen Lauf auslöst

MODE=build
TARGET=qemu_arm_tv
JOBS=6
FROM_STAGE=check-target
LOS_DIR=/mnt/github-runner/lineage-22.2
INSTALL_DEPS=0
ALLOW_UNDERSIZED=1
FORCE=1
REQUEST_ID=2026-11-11-build069-m3-displaydiag
