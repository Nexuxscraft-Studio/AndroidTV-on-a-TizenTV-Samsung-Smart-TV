+/*
+ * Resolve the six firmware dependencies through CCF. SDP1804 display
+ * gates are still unverified, so never enable or change their rates here.
+ */
+static int sdp_drm_get_display_clocks(struct device *dev)
+{
+	struct clk_bulk_data clocks[] = {
+		{ .id = "osdp_clk_c" },
+		{ .id = "osdp_clk_vo" },
+		{ .id = "gp_clk_c" },
+		{ .id = "gp_clk_vo" },
+		{ .id = "gfxp_clk_c" },
+		{ .id = "gfxp_clk_vo" },
+	};
+	struct clk_bulk_data *managed;
+
+	managed = devm_kmemdup(dev, clocks, sizeof(clocks), GFP_KERNEL);
+	if (!managed)
+		return -ENOMEM;
+
+	return devm_clk_bulk_get(dev, ARRAY_SIZE(clocks), managed);
+}
+
+static int sdp_drm_prepare_test_pattern(struct device *dev,
+					struct sdp_scanout *scanout)
+{
+	static const u32 colors[] = {
+		0xffffff, 0xffff00, 0x00ffff, 0x00ff00,
+		0xff00ff, 0xff0000, 0x0000ff, 0x000000,
+	};
+	const u32 width = SDP_DRM_DEFAULT_WIDTH;
+	const u32 height = SDP_DRM_DEFAULT_HEIGHT;
+	const size_t bytes = width * height * sizeof(__le32);
+	dma_addr_t addr;
+	unsigned int x, y;
+	__le32 *pixels;
+
+	pixels = dmam_alloc_coherent(dev, bytes, &addr, GFP_KERNEL);
+	if (!pixels)
+		return -ENOMEM;
+	if (addr > U32_MAX - (bytes - 1) || !IS_ALIGNED(addr, sizeof(*pixels)))
+		return -ERANGE;
+
+	for (y = 0; y < height; y++) {
+		for (x = 0; x < width; x++) {
+			u32 color = colors[x / (width / ARRAY_SIZE(colors))];
+
+			if (y == 0 || y == height - 1 || x == 0 || x == width - 1)
+				color = 0x808080;
+			pixels[y * width + x] = cpu_to_le32(color);
+		}
+	}
+
+	*scanout = (struct sdp_scanout) {
+		.dma_addr = addr,
+		.width = width,
+		.height = height,
+		.pitch = width * sizeof(*pixels),
+		.format = DRM_FORMAT_XRGB8888,
+	};
+	return 0;
+}
