-			"Build 087 hardware access disabled pending register/IRQ validation\n");
+			"display access disabled pending clock, reset and register validation\n");
 
 	/* Future integration order, compiled for API coverage only. */
 	sdp = devm_drm_dev_alloc(&pdev->dev, &sdp_drm_driver,
@@ -155,6 +221,14 @@ static int sdp_drm_probe(struct platform_device *pdev)
 	ret = dma_set_mask_and_coherent(&pdev->dev, DMA_BIT_MASK(32));
 	if (ret)
 		return ret;
+	ret = sdp_drm_get_display_clocks(&pdev->dev);
