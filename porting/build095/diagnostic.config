# Build 095 design fragment. Review effective values after olddefconfig.
# Start with Build 059 arm tiny and its embedded diagnostic /init.
CONFIG_ARM_LPAE=y
CONFIG_ARM_PSCI=y
CONFIG_ARCH_SDP=y
CONFIG_SERIAL_SDP=y
CONFIG_SERIAL_SDP_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BINFMT_ELF=y
# CONFIG_MODULES is not set
# CONFIG_SMP is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_THERMAL is not set
# CONFIG_DRM is not set
# CONFIG_SND is not set
# CONFIG_NET is not set
# CONFIG_MMC is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_SDP_MICOM is not set
# CONFIG_SDP_MSGBOX is not set
# CONFIG_SDP1804_GPU_POWER is not set
